enum Gender {
  FEMALE
  MALE
}

enum AssignmentType {
  HOMEWORK
  EXAM
  QUIZ
  PROJECT
  PAPER
  NEW
}

enum QuizQuestionType {
  TEXT
  SINGLE_CHOICE
  MULTIPLE_CHOICE
  TRUE_FALSE
  MATCH
}

enum WeekDay {
  MONDAY
  TUESDAY
  WEDNESDAY
  THURSDAY
  FRIDAY
  SATURDAY
  SUNDAY
}

enum FilePermission {
  VIEW
  EDIT
}

enum AttendanceStatus {
  PRESENT
  ABSENT
  LATE
  SICK_LEAVE
  EXCUSED
}

enum EnrollmentStatus {
  ACTIVE
  CANDIDATE
  RETIRED
}

enum JoinRequestStatus {
  PENDING
  APPROVED
  REJECTED
}

enum HabitValue {
  X // Bad performance
  R // Regular performance
  S // Good performance (Satisfactorio)
}

enum ChargeType {
  ENROLLMENT
  TUITION
  CUSTOM
}

enum ChargeStatus {
  PENDING
  PAID
  PARTIAL
  OVERDUE
}

model AttendanceSession {
  id             String             @id @default(cuid())
  date           DateTime           @db.Date
  courseId       String
  course         Course             @relation(fields: [courseId], references: [id], onDelete: Cascade)
  classGroupId   String
  classGroup     ClassGroup         @relation(fields: [classGroupId], references: [id], onDelete: Cascade)
  teacherId      String
  teacher        Teacher            @relation(fields: [teacherId], references: [id])
  organizationId String
  organization   Organization       @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  records        AttendanceRecord[]
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt

  @@unique([courseId, classGroupId, date])
  @@index([courseId])
  @@index([classGroupId])
  @@index([date])
  @@map("attendance_sessions")
}

model AttendanceRecord {
  id                  String            @id @default(cuid())
  attendanceSessionId String
  attendanceSession   AttendanceSession @relation(fields: [attendanceSessionId], references: [id], onDelete: Cascade)
  studentId           String
  student             Student           @relation(fields: [studentId], references: [id], onDelete: Cascade)
  status              AttendanceStatus
  comment             String?
  createdAt           DateTime          @default(now())
  updatedAt           DateTime          @updatedAt

  @@unique([attendanceSessionId, studentId])
  @@index([studentId])
  @@map("attendance_records")
}

model HabitMetric {
  id          String            @id @default(cuid())
  name        String            @unique
  description String?
  active      Boolean           @default(true)
  order       Int               @default(0)
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt
  evaluations HabitEvaluation[]

  @@index([active])
  @@map("habit_metrics")
}

model HabitEvaluation {
  id                 String                   @id @default(cuid())
  habitMetricId      String
  habitMetric        HabitMetric              @relation(fields: [habitMetricId], references: [id], onDelete: Cascade)
  classGroupId       String
  classGroup         ClassGroup               @relation(fields: [classGroupId], references: [id], onDelete: Cascade)
  periodId           String
  period             Period                   @relation(fields: [periodId], references: [id], onDelete: Cascade)
  teacherId          String
  teacher            Teacher                  @relation(fields: [teacherId], references: [id], onDelete: Cascade)
  organizationId     String
  organization       Organization             @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  published          Boolean                  @default(false)
  createdAt          DateTime                 @default(now())
  updatedAt          DateTime                 @updatedAt
  studentEvaluations StudentHabitEvaluation[]

  @@unique([habitMetricId, classGroupId, periodId])
  @@index([classGroupId, periodId])
  @@map("habit_evaluations")
}

model StudentHabitEvaluation {
  id                String          @id @default(cuid())
  habitEvaluationId String
  habitEvaluation   HabitEvaluation @relation(fields: [habitEvaluationId], references: [id], onDelete: Cascade)
  studentId         String
  student           Student         @relation(fields: [studentId], references: [id], onDelete: Cascade)
  value             HabitValue
  comments          String?
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt

  @@unique([habitEvaluationId, studentId])
  @@index([studentId])
  @@map("student_habit_evaluations")
}

enum StoreOrderStatus {
  PENDING
  CONFIRMED
  PROCESSING
  READY
  DELIVERED
  CANCELLED
}

enum StorePaymentStatus {
  PENDING
  PAID
  FAILED
  REFUNDED
}

model StoreCategory {
  id          String         @id @default(cuid())
  schoolId    String
  school      School         @relation(fields: [schoolId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  name        String
  description String?
  sortOrder   Int            @default(0)
  active      Boolean        @default(true)
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt
  products    StoreProduct[]

  @@index([schoolId, active])
  @@map("store_categories")
}

model StoreProduct {
  id          String                @id @default(cuid())
  schoolId    String
  school      School                @relation(fields: [schoolId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  categoryId  String?
  category    StoreCategory?        @relation(fields: [categoryId], references: [id], onDelete: SetNull, onUpdate: Cascade)
  name        String
  description String?
  price       Decimal               @db.Decimal(12, 2)
  imageUrl    String?
  active      Boolean               @default(true)
  createdAt   DateTime              @default(now())
  updatedAt   DateTime              @updatedAt
  variants    StoreProductVariant[]
  orderItems  StoreOrderItem[]

  @@index([schoolId, active])
  @@map("store_products")
}

model StoreProductVariant {
  id        String   @id @default(cuid())
  productId String
  product   StoreProduct @relation(fields: [productId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  label     String
  stock     Int      @default(0)
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  cartItems StoreCartItem[]
  orderItems StoreOrderItem[]

  @@unique([productId, label])
  @@index([productId])
  @@map("store_product_variants")
}

model StoreCartItem {
  id        String              @id @default(cuid())
  userId    String
  user      User                @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  variantId String
  variant   StoreProductVariant @relation(fields: [variantId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  quantity  Int                 @default(1)
  createdAt DateTime            @default(now())
  updatedAt DateTime            @updatedAt

  @@unique([userId, variantId])
  @@index([userId])
  @@map("store_cart_items")
}

model StoreOrder {
  id             String             @id @default(cuid())
  schoolId       String
  school         School             @relation(fields: [schoolId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  userId         String
  user           User               @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  total          Decimal            @db.Decimal(12, 2)
  status         StoreOrderStatus   @default(PENDING)
  paymentStatus  StorePaymentStatus @default(PENDING)
  notes          String?
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt
  items          StoreOrderItem[]

  @@index([schoolId, createdAt])
  @@index([userId, createdAt])
  @@map("store_orders")
}

model StoreOrderItem {
  id           String               @id @default(cuid())
  orderId      String
  order        StoreOrder           @relation(fields: [orderId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  productId    String
  product      StoreProduct         @relation(fields: [productId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  variantId    String?
  variant      StoreProductVariant? @relation(fields: [variantId], references: [id], onDelete: SetNull, onUpdate: Cascade)
  variantLabel String?
  quantity     Int
  unitPrice    Decimal              @db.Decimal(12, 2)

  @@index([orderId])
  @@map("store_order_items")
}
