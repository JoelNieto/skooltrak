# Copy to .env on the server, next to compose.yml (chmod 600). Never commit the real file.
# Only the backends read the secrets below; the frontends get just their public hostnames.

# ── Domains (DNS A/AAAA records must point at this server before the first start) ──
APP_DOMAIN=app.example.com
ADMIN_DOMAIN=admin.example.com
# Let's Encrypt account / expiry notices
ACME_EMAIL=ops@example.com

# Image registry; the deploy workflow sets IMAGE_TAG to the commit being deployed.
REGISTRY=ghcr.io/joelnieto
IMAGE_TAG=latest

# ── Database: Neon, POOLED connection string (host contains "-pooler") ──
DATABASE_URL=postgresql://user:password@ep-xxx-pooler.us-east-1.aws.neon.tech/skooltrak?sslmode=require

# ── Auth: generate each with `openssl rand -base64 32` ──
BETTER_AUTH_SECRET=
JWT_SECRET=

# ── Cloudflare R2 (file storage) ──
CLOUDFLARE_R2_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
CLOUDFLARE_R2_ACCESS_KEY_ID=
CLOUDFLARE_R2_SECRET_ACCESS_KEY=
CLOUDFLARE_R2_BUCKET=skooltrak

# ── Resend (email: verification, password reset, invitations) ──
RESEND_API_KEY=
EMAIL_FROM=Skooltrak <noreply@example.com>

# ── Optional ──
# NOVU_WEBHOOK_SECRET=
