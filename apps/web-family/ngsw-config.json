{
  "$schema": "../../node_modules/@angular/service-worker/config.schema.json",
  "index": "/index.html",
  "assetGroups": [
    {
      "name": "app-shell",
      "installMode": "prefetch",
      "resources": {
        "files": ["/index.html", "/favicon.ico", "/manifest.webmanifest", "/*.css", "/*.js"]
      }
    },
    {
      "name": "assets",
      "installMode": "lazy",
      "updateMode": "prefetch",
      "resources": {
        "files": ["/public/**/*", "/media/**/*"]
      }
    }
  ],
  "dataGroups": [
    {
      "name": "communication-api",
      "urls": ["/api/v1/communication/**"],
      "method": "GET",
      "cacheConfig": {
        "maxSize": 50,
        "maxAge": "10m",
        "timeout": "10s",
        "strategy": "freshness"
      }
    }
  ]
}
