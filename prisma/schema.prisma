// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Organization {
  id          String       @id @default(cuid())
  name        String
  description String
  active      Boolean      @default(true)
  users       User[]
  roles       Role[]
  schools     School[]
  subjects    Subject[]
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  groups      ClassGroup[]
  courses     Course[]
  Teacher     Teacher[]
  Student     Student[]
}

model User {
  id             String        @id @default(cuid())
  email          String        @unique
  firstName      String
  lastName       String
  password       String
  role           Role          @relation(fields: [roleId], references: [id])
  roleId         String
  organization   Organization? @relation(fields: [organizationId], references: [id])
  organizationId String?
  lastLogin      DateTime?
  isBlocked      Boolean       @default(false)
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
  student        Student?
  teacher        Teacher?
}

model Role {
  id             String        @id @default(cuid())
  name           String
  description    String
  users          User[]
  permissions    Permission[]
  organization   Organization? @relation(fields: [organizationId], references: [id])
  organizationId String?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  @@unique([organizationId, name])
}

model Permission {
  id            String   @id @default(cuid())
  descriptiveId String   @unique
  description   String
  roles         Role[]
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

model School {
  id             String       @id @default(cuid())
  organization   Organization @relation(fields: [organizationId], references: [id])
  organizationId String
  name           String
  shortName      String
  logo           String
  address        String
  city           String
  state          String
  zip            String
  country        String
  email          String
  phone          String
  website        String
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  studyPlans     StudyPlan[]
  degrees        Degree[]
  courses        Course[]
  classGroups    ClassGroup[]
  students       Student[]
  assignments    Assignment[]
}

model Subject {
  id             String       @id @default(cuid())
  organization   Organization @relation(fields: [organizationId], references: [id])
  organizationId String
  name           String
  code           String
  shortName      String
  courses        Course[]
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@unique([organizationId, name, code])
}

model Degree {
  id         String      @id @default(cuid())
  name       String
  shortName  String
  schoolId   String
  school     School      @relation(fields: [schoolId], references: [id])
  createdAt  DateTime    @default(now())
  updatedAt  DateTime    @updatedAt
  studyPlans StudyPlan[]
}

model StudyPlan {
  id          String       @id @default(cuid())
  name        String
  shortName   String
  level       Int
  degreeId    String
  degree      Degree       @relation(fields: [degreeId], references: [id])
  description String
  code        String
  schoolId    String
  school      School       @relation(fields: [schoolId], references: [id])
  courses     Course[]
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  classGroups ClassGroup[]

  @@unique([schoolId, name])
  @@unique([schoolId, code])
}

model Course {
  id             String       @id @default(cuid())
  name           String
  code           String
  shortName      String
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])
  schoolId       String
  school         School       @relation(fields: [schoolId], references: [id])
  subjectId      String
  subject        Subject      @relation(fields: [subjectId], references: [id])
  studyPlanId    String
  studyPlan      StudyPlan    @relation(fields: [studyPlanId], references: [id])
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  groups         ClassGroup[]
  students       Student[]
  teacher        Teacher?     @relation(fields: [teacherId], references: [id])
  teacherId      String?
  assignments    Assignment[]

  @@unique([schoolId, name])
  @@unique([schoolId, code])
  @@unique([schoolId, subjectId, studyPlanId])
}

model ClassGroup {
  id              String          @id @default(cuid())
  name            String
  shortName       String
  organizationId  String
  organization    Organization    @relation(fields: [organizationId], references: [id])
  schoolId        String
  school          School          @relation(fields: [schoolId], references: [id])
  courses         Course[]
  studyPlan       StudyPlan       @relation(fields: [studyPlanId], references: [id])
  active          Boolean
  students        Student[]
  teacher         Teacher?        @relation(fields: [teacherId], references: [id])
  teacherId       String?
  studyPlanId     String
  assignmentDates AssigmentDate[]
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt
}

model Student {
  id             String       @id @default(cuid())
  firstName      String
  middleName     String
  fatherName     String
  motherName     String
  documentId     String
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])
  school         School       @relation(fields: [schoolId], references: [id])
  schoolId       String
  classGroup     ClassGroup   @relation(fields: [classGroupId], references: [id])
  classGroupId   String
  birthDate      DateTime
  gender         Gender
  address        String
  phone          String
  courses        Course[]
  userId         String       @unique
  user           User         @relation(fields: [userId], references: [id])
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
}

model Teacher {
  id             String       @id @default(cuid())
  firstName      String
  middleName     String
  fatherName     String
  motherName     String
  documentId     String
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])
  birthDate      DateTime
  gender         Gender
  classGroups    ClassGroup[]
  courses        Course[]
  user           User         @relation(fields: [userId], references: [id])
  userId         String       @unique
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  assignments    Assignment[]
}

model Assignment {
  id                String          @id @default(cuid())
  title             String
  details           String
  type              AssignmentType
  school            School          @relation(fields: [schoolId], references: [id])
  course            Course          @relation(fields: [courseId], references: [id])
  date              DateTime
  schoolId          String
  courseId          String
  dates             AssigmentDate[]
  requireSubmission Boolean
  teacher           Teacher         @relation(fields: [teacherId], references: [id])
  teacherId         String
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt
}

model AssigmentDate {
  id           String     @id @default(cuid())
  date         DateTime
  assignment   Assignment @relation(fields: [assignmentId], references: [id])
  assignmentId String
  classGroup   ClassGroup @relation(fields: [classGroupId], references: [id])
  classGroupId String
}

enum Gender {
  FEMALE
  MALE
}

enum AssignmentType {
  HOMEWORK
  EXAM
  QUIZ
  PROJECT
  PAPER
  NEW
}
