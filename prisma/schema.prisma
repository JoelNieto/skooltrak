// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Organization {
  id          String       @id @default(cuid())
  name        String
  description String
  active      Boolean      @default(true)
  users       User[]
  roles       Role[]
  schools     School[]
  subjects    Subject[]
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  groups      ClassGroup[]
  courses     Course[]
  Teacher     Teacher[]
  Student     Student[]
  quizzes     Quiz[]
  messages    Message[]
}

model User {
  id                String             @id @default(cuid())
  email             String             @unique
  firstName         String
  lastName          String
  password          String
  color             String?
  role              Role               @relation(fields: [roleId], references: [id])
  roleId            String
  organization      Organization?      @relation(fields: [organizationId], references: [id])
  organizationId    String?
  lastLogin         DateTime?
  isBlocked         Boolean            @default(false)
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt
  student           Student?
  teacher           Teacher?
  sentMessages      Message[]
  messageRecipients MessageRecipient[]
}

model Message {
  id             String             @id @default(cuid())
  subject        String
  content        String
  organization   Organization       @relation(fields: [organizationId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  organizationId String
  sender         User?              @relation(fields: [senderId], references: [id], onDelete: SetNull, onUpdate: Cascade)
  senderId       String?
  recipients     MessageRecipient[]
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt
  deletedAt      DateTime?
}

model MessageRecipient {
  id        String    @id @default(cuid())
  messageId String
  userId    String
  message   Message   @relation(fields: [messageId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  readAt    DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  @@unique([messageId, userId])
}

model Role {
  id             String        @id @default(cuid())
  name           String
  description    String
  users          User[]
  permissions    Permission[]
  organization   Organization? @relation(fields: [organizationId], references: [id])
  organizationId String?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  @@unique([organizationId, name])
}

model Permission {
  id            String   @id @default(cuid())
  descriptiveId String   @unique
  description   String
  roles         Role[]
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

model School {
  id             String       @id @default(cuid())
  organization   Organization @relation(fields: [organizationId], references: [id])
  organizationId String
  name           String
  shortName      String
  logo           String
  address        String
  city           String
  state          String
  zip            String
  country        String
  email          String
  phone          String
  website        String
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  studyPlans     StudyPlan[]
  degrees        Degree[]
  courses        Course[]
  classGroups    ClassGroup[]
  students       Student[]
  assignments    Assignment[]
  currentYear    Int          @default(2025)
  periods        Period[]
}

model Period {
  id        String   @id @default(cuid())
  schoolId  String
  school    School   @relation(fields: [schoolId], references: [id])
  name      String
  shortName String
  year      Int
  startDate DateTime
  endDate   DateTime
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  courses   Course[]

  grades Grade[]
}

model Subject {
  id             String       @id @default(cuid())
  organization   Organization @relation(fields: [organizationId], references: [id])
  organizationId String
  name           String
  code           String
  shortName      String
  courses        Course[]
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  teachers       Teacher[]

  @@unique([organizationId, name, code])
}

model Degree {
  id         String      @id @default(cuid())
  name       String
  shortName  String
  schoolId   String
  school     School      @relation(fields: [schoolId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  createdAt  DateTime    @default(now())
  updatedAt  DateTime    @updatedAt
  studyPlans StudyPlan[]
}

model StudyPlan {
  id            String       @id @default(cuid())
  name          String
  shortName     String
  level         Int
  degreeId      String
  degree        Degree       @relation(fields: [degreeId], references: [id])
  description   String
  code          String
  schoolId      String
  school        School       @relation(fields: [schoolId], references: [id])
  courses       Course[]
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt
  classGroups   ClassGroup[]
  gradeMetric   GradeMetric? @relation(fields: [gradeMetricId], references: [id], onDelete: SetNull)
  gradeMetricId String?

  @@unique([schoolId, name])
  @@unique([schoolId, code])
}

model Course {
  id              String        @id @default(cuid())
  name            String
  code            String
  shortName       String
  organizationId  String
  organization    Organization  @relation(fields: [organizationId], references: [id])
  schoolId        String
  school          School        @relation(fields: [schoolId], references: [id])
  subjectId       String
  subject         Subject       @relation(fields: [subjectId], references: [id])
  studyPlanId     String
  studyPlan       StudyPlan     @relation(fields: [studyPlanId], references: [id])
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
  groups          ClassGroup[]
  students        Student[]
  teacher         Teacher?      @relation(fields: [teacherId], references: [id], onDelete: SetNull, onUpdate: Cascade)
  teacherId       String?
  assignments     Assignment[]
  quizzes         Quiz[]
  currentPeriod   Period?       @relation(fields: [currentPeriodId], references: [id], onDelete: SetNull, onUpdate: Cascade)
  currentPeriodId String?
  gradeBuckets    GradeBucket[]
  grades          Grade[]

  @@unique([schoolId, name])
  @@unique([schoolId, code])
  @@unique([schoolId, subjectId, studyPlanId])
}

model ClassGroup {
  id              String           @id @default(cuid())
  name            String
  shortName       String
  organizationId  String
  organization    Organization     @relation(fields: [organizationId], references: [id])
  schoolId        String
  school          School           @relation(fields: [schoolId], references: [id])
  courses         Course[]
  studyPlan       StudyPlan        @relation(fields: [studyPlanId], references: [id])
  active          Boolean
  students        Student[]
  teacher         Teacher?         @relation(fields: [teacherId], references: [id])
  teacherId       String?
  studyPlanId     String
  assignmentDates AssignmentDate[]
  quizSchedules   QuizSchedule[]
  quizSubmissions QuizSubmission[]
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
}

model Student {
  id              String           @id @default(cuid())
  firstName       String
  middleName      String
  fatherName      String
  motherName      String
  documentId      String
  organizationId  String
  organization    Organization     @relation(fields: [organizationId], references: [id])
  school          School           @relation(fields: [schoolId], references: [id])
  schoolId        String
  classGroup      ClassGroup       @relation(fields: [classGroupId], references: [id])
  classGroupId    String
  birthDate       DateTime
  gender          Gender
  address         String
  phone           String
  courses         Course[]
  userId          String           @unique
  user            User             @relation(fields: [userId], references: [id])
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  quizSubmissions QuizSubmission[]
  gradeStudents   GradeStudent[]
}

model Teacher {
  id             String       @id @default(cuid())
  firstName      String
  middleName     String
  fatherName     String
  motherName     String
  documentId     String
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])
  birthDate      DateTime
  address        String       @default("")
  phoneNumber    String       @default("")
  personalEmail  String       @default("")
  about          String       @default("")
  teacherSince   Int?
  memberSince    DateTime?
  subjects       Subject[]
  gender         Gender
  classGroups    ClassGroup[]
  courses        Course[]
  user           User         @relation(fields: [userId], references: [id])
  userId         String       @unique
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  assignments    Assignment[]
  quizzes        Quiz[]
}

model Assignment {
  id                String           @id @default(cuid())
  title             String
  details           String
  type              AssignmentType
  school            School           @relation(fields: [schoolId], references: [id])
  course            Course           @relation(fields: [courseId], references: [id])
  date              DateTime
  schoolId          String
  courseId          String
  dates             AssignmentDate[]
  requireSubmission Boolean
  teacher           Teacher          @relation(fields: [teacherId], references: [id])
  teacherId         String
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt
}

model AssignmentDate {
  id           String     @id @default(cuid())
  date         DateTime
  assignment   Assignment @relation(fields: [assignmentId], references: [id])
  assignmentId String
  classGroup   ClassGroup @relation(fields: [classGroupId], references: [id])
  classGroupId String
}

model Quiz {
  id              String           @id @default(cuid())
  title           String
  details         String
  organization    Organization     @relation(fields: [organizationId], references: [id])
  organizationId  String
  course          Course           @relation(fields: [courseId], references: [id])
  courseId        String
  teacher         Teacher          @relation(fields: [teacherId], references: [id])
  teacherId       String
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  questions       QuizQuestion[]
  schedules       QuizSchedule[]
  quizSubmissions QuizSubmission[]
}

model QuizQuestion {
  id                  String                   @id @default(cuid())
  question            String
  quiz                Quiz                     @relation(fields: [quizId], references: [id])
  quizId              String
  value               Decimal
  type                QuizQuestionType
  options             QuizQuestionOption[]
  submissionQuestions QuizSubmissionQuestion[]
  timeLimit           Int?
}

model QuizQuestionOption {
  id                  String                   @id @default(cuid())
  option              String
  question            QuizQuestion             @relation(fields: [questionId], references: [id])
  questionId          String
  isCorrect           Boolean
  submissionQuestions QuizSubmissionQuestion[]
}

model QuizSchedule {
  id           String     @id @default(cuid())
  quiz         Quiz       @relation(fields: [quizId], references: [id])
  quizId       String
  classGroup   ClassGroup @relation(fields: [classGroupId], references: [id])
  classGroupId String
  startDate    DateTime
  dueDate      DateTime
  published    Boolean
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
}

model QuizSubmission {
  id                  String                   @id @default(cuid())
  quiz                Quiz                     @relation(fields: [quizId], references: [id])
  quizId              String
  student             Student                  @relation(fields: [studentId], references: [id])
  studentId           String
  classGroup          ClassGroup               @relation(fields: [classGroupId], references: [id])
  classGroupId        String
  submissionQuestions QuizSubmissionQuestion[]
  score               Decimal
  createdAt           DateTime                 @default(now())
  updatedAt           DateTime                 @updatedAt
}

model QuizSubmissionQuestion {
  id               String               @id @default(cuid())
  quizSubmission   QuizSubmission       @relation(fields: [quizSubmissionId], references: [id])
  quizSubmissionId String
  quizQuestion     QuizQuestion         @relation(fields: [quizQuestionId], references: [id])
  quizQuestionId   String
  answer           String
  options          QuizQuestionOption[]
  isCorrect        Boolean
  score            Decimal
  comment          String?
}

model GradeMetric {
  id                String      @id @default(cuid())
  name              String
  minimum           Decimal
  maximum           Decimal
  minimumApproval   Decimal
  minimumExcellence Decimal
  createdAt         DateTime    @default(now())
  updatedAt         DateTime    @updatedAt
  studyPlans        StudyPlan[]
}

model GradeBucket {
  id        String   @id @default(cuid())
  name      String
  weight    Decimal
  courseId  String
  course    Course   @relation(fields: [courseId], references: [id])
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  grades    Grade[]
}

model Grade {
  id            String         @id @default(cuid())
  title         String
  comments      String?
  courseId      String
  course        Course         @relation(fields: [courseId], references: [id])
  bucketId      String
  bucket        GradeBucket    @relation(fields: [bucketId], references: [id])
  periodId      String
  period        Period         @relation(fields: [periodId], references: [id])
  date          DateTime
  published     Boolean        @default(false)
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  gradeStudents GradeStudent[]
}

model GradeStudent {
  id        String                 @id @default(cuid())
  comments  String?
  gradeId   String
  grade     Grade                  @relation(fields: [gradeId], references: [id], onDelete: Cascade)
  studentId String
  student   Student                @relation(fields: [studentId], references: [id])
  score     Decimal?
  createdAt DateTime               @default(now())
  updatedAt DateTime               @updatedAt
  revisions GradeStudentRevision[]
}

model GradeStudentRevision {
  id             String       @id @default(cuid())
  reason         String
  gradeStudentId String
  gradeStudent   GradeStudent @relation(fields: [gradeStudentId], references: [id])
  score          Decimal
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
}

enum Gender {
  FEMALE
  MALE
}

enum AssignmentType {
  HOMEWORK
  EXAM
  QUIZ
  PROJECT
  PAPER
  NEW
}

enum QuizQuestionType {
  TEXT
  SINGLE_CHOICE
  MULTIPLE_CHOICE
  TRUE_FALSE
  MATCH
}
