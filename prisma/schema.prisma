// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider     = "prisma-client"
  output       = "../generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

model Organization {
  id                       String                     @id @default(cuid())
  name                     String
  slug                     String?                    @unique
  logo                     String?
  metadata                 String?
  description              String
  active                   Boolean                    @default(true)
  onboardingCompleted      Boolean                    @default(false)
  users                    User[]
  roles                    Role[]
  schools                  School[]
  subjects                 Subject[]
  createdAt                DateTime                   @default(now())
  updatedAt                DateTime                   @updatedAt
  groups                   ClassGroup[]
  courses                  Course[]
  Teacher                  Teacher[]
  Student                  Student[]
  Parent                   Parent[]
  quizzes                  Quiz[]
  files                    File[]
  attendanceSessions       AttendanceSession[]
  habitEvaluations         HabitEvaluation[]
  // Better-auth organization plugin
  members                  Member[]
  invitations              Invitation[]
  importJobs               ImportJob[]
  authTokens               AuthToken[]
  studentClassGroupHistory StudentClassGroupHistory[]
  channels                 Channel[]
  directConversations      DirectConversation[]
  familyAccounts           FamilyAccount[]
  payments                 Payment[]
  charges                  Charge[]

  @@map("organizations")
}

model User {
  id                     String                     @id @default(cuid())
  email                  String                     @unique
  name                   String?
  firstName              String
  lastName               String
  password               String
  color                  String?
  image                  String?
  emailVerified          Boolean                    @default(false)
  banned                 Boolean                    @default(false)
  banReason              String?
  banExpires             DateTime?
  role                   Role?                      @relation(fields: [roleId], references: [id])
  roleId                 String?
  organization           Organization?              @relation(fields: [organizationId], references: [id], onDelete: SetNull, onUpdate: Cascade)
  organizationId         String?
  onboardingStep         String? // 'choose-path', 'school-setup', 'waiting-approval', 'completed'
  themePreference        String? // 'light' | 'dark' | 'system'
  lastLogin              DateTime?
  isBlocked              Boolean                    @default(false)
  createdAt              DateTime                   @default(now())
  updatedAt              DateTime                   @updatedAt
  student                Student?
  teacher                Teacher?
  parents                Parent[]
  filesOwned             File[]
  fileShares             FileShareUser[]
  notifications          Notification[]
  joinRequests           JoinRequest[]
  storeCartItems         StoreCartItem[]
  courseEnrollmentsAdded CourseEnrollment[]         @relation("CourseEnrollmentAddedBy")
  gradesPublished        Grade[]                    @relation("GradePublishedBy")
  gradeRevisions         StudentGradeRevision[]     @relation("StudentGradeRevisionChangedBy")
  storeOrders            StoreOrder[]
  // Better-auth relations
  sessions               Session[]
  accounts               Account[]
  members                Member[]
  authTokens             AuthToken[]
  channelsCreated        Channel[]                  @relation("ChannelCreatedBy")
  channelPosts           ChannelPost[]
  channelReplies         ChannelReply[]             @relation("ChannelReplyAuthor")
  channelReplyThreads    ChannelReply[]             @relation("ChannelReplyThread")
  channelPostReads       ChannelPostRead[]
  directAsStaff          DirectConversation[]       @relation("DirectStaff")
  directAsParent         DirectConversation[]       @relation("DirectParent")
  directReportsFiled     DirectConversationReport[] @relation("DirectReportBy")
  directReportsResolved  DirectConversationReport[] @relation("DirectReportResolver")
  directReviews          DirectConversationAccess[]
  channelPostReminders   ChannelPostReminder[]
  directMessages         DirectMessage[]

  @@map("users")
}

/// The 8 course color tags (ACA-001 BR .11); rendered through libs/ui `--color-course-<key>` tokens.
enum CourseColor {
  INDIGO
  TEAL
  ROSE
  VIOLET
  AMBER
  SLATE
  FUCHSIA
  GREEN
}

model File {
  id                    String                 @id @default(cuid())
  organizationId        String
  organization          Organization           @relation(fields: [organizationId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  ownerId               String?
  owner                 User?                  @relation(fields: [ownerId], references: [id], onDelete: SetNull, onUpdate: Cascade)
  name                  String
  mimeType              String
  size                  Int
  storageKey            String
  sharesUsers           FileShareUser[]
  sharesSchools         FileShareSchool[]
  sharesClassGroups     FileShareClassGroup[]
  sharesCourses         FileShareCourse[]
  assignmentSubmissions AssignmentSubmission[]
  createdAt             DateTime               @default(now())
  updatedAt             DateTime               @updatedAt
  deletedAt             DateTime?

  @@index([organizationId])
  @@index([ownerId])
  @@map("files")
}

model FileShareUser {
  id         String         @id @default(cuid())
  fileId     String
  file       File           @relation(fields: [fileId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  userId     String
  user       User           @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  permission FilePermission
  createdAt  DateTime       @default(now())
  updatedAt  DateTime       @updatedAt

  @@unique([fileId, userId])
  @@index([userId])
  @@map("file_share_users")
}

model FileShareSchool {
  id         String         @id @default(cuid())
  fileId     String
  file       File           @relation(fields: [fileId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  schoolId   String
  school     School         @relation(fields: [schoolId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  permission FilePermission
  createdAt  DateTime       @default(now())
  updatedAt  DateTime       @updatedAt

  @@unique([fileId, schoolId])
  @@index([schoolId])
  @@map("file_share_schools")
}

model FileShareClassGroup {
  id           String         @id @default(cuid())
  fileId       String
  file         File           @relation(fields: [fileId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  classGroupId String
  classGroup   ClassGroup     @relation(fields: [classGroupId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  permission   FilePermission
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt

  @@unique([fileId, classGroupId])
  @@index([classGroupId])
  @@map("file_share_class_groups")
}

model FileShareCourse {
  id         String         @id @default(cuid())
  fileId     String
  file       File           @relation(fields: [fileId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  courseId   String
  course     Course         @relation(fields: [courseId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  permission FilePermission
  createdAt  DateTime       @default(now())
  updatedAt  DateTime       @updatedAt

  @@unique([fileId, courseId])
  @@index([courseId])
  @@map("file_share_courses")
}

model Role {
  id             String        @id @default(cuid())
  name           String
  description    String
  users          User[]
  permissions    Permission[]
  organization   Organization? @relation(fields: [organizationId], references: [id])
  organizationId String?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  @@unique([organizationId, name])
  @@map("roles")
}

model Permission {
  id            String   @id @default(cuid())
  descriptiveId String   @unique
  description   String
  roles         Role[]
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@map("permissions")
}

model School {
  id                       String                     @id @default(cuid())
  organization             Organization               @relation(fields: [organizationId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  organizationId           String
  /// Public URL segment for the school store (e.g. /store/my-school)
  slug                     String?                    @unique
  name                     String
  shortName                String
  logo                     String
  currencyCode             String                     @default("USD")
  address                  String
  city                     String
  state                    String
  zip                      String
  country                  String
  email                    String
  phone                    String
  website                  String
  primaryColor             String?
  secondaryColor           String?
  tertiaryColor            String?
  createdAt                DateTime                   @default(now())
  updatedAt                DateTime                   @updatedAt
  studyPlans               StudyPlan[]
  degrees                  Degree[]
  courses                  Course[]
  classGroups              ClassGroup[]
  students                 Student[]
  studentClassGroupHistory StudentClassGroupHistory[]
  assignments              Assignment[]
  currentYear              Int                        @default(2025)
  schoolYearStartMonth     Int                        @default(3)
  /// IANA timezone (e.g. "America/Panama"). Home dashboards evaluate "today"/"now" in it (BR-HOM-001.4).
  timezone                 String                     @default("America/Panama")
  fileShares               FileShareSchool[]
  joinRequests             JoinRequest[]
  charges                  Charge[]
  familyAccounts           FamilyAccount[]
  feeItems                 FeeItem[]
  payments                 Payment[]
  financeSettings          FinanceSettings?
  storeCategories          StoreCategory[]
  storeProducts            StoreProduct[]
  storeOrders              StoreOrder[]
  importJobs               ImportJob[]
  periods                  Period[]
  habitMetrics             HabitMetric[]
  channels                 Channel[]

  @@map("schools")
}

/// A grading period. Global (schoolId null) periods are the platform default for a year; a school
/// that uses its own calendar (e.g. an American Aug–Jun year) owns its periods for that year instead.
model Period {
  id               String            @id @default(cuid())
  name             String
  shortName        String            @default("")
  /// School year label (e.g. 2026 for Aug 2026 – Jun 2027); dates may cross calendar years.
  year             Int
  startDate        DateTime
  endDate          DateTime
  school           School?           @relation(fields: [schoolId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  /// Null: global period. Set: one school's own period, which replaces the global ones for its year.
  schoolId         String?
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
  grades           Grade[]
  habitEvaluations HabitEvaluation[]

  @@index([year, name])
  @@index([year, shortName])
  @@index([schoolId, year])
  @@map("periods")
}

model Subject {
  id             String       @id @default(cuid())
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  organizationId String
  name           String
  code           String
  /// Lucide icon name from SUBJECT_ICONS (libs/shared). Null: "book-open".
  icon           String?
  /// Free-text area grouping subjects on Mis cursos, e.g. "Ciencias" (ACA-001 BR .14). Trimmed; null: "Otras".
  area           String?
  courses        Course[]
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  teachers       Teacher[]

  @@unique([organizationId, name, code])
  @@map("subjects")
}

model Degree {
  id             String          @id @default(cuid())
  name           String
  shortName      String
  schoolId       String
  school         School          @relation(fields: [schoolId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  studyPlans     StudyPlan[]
  feeAssignments FeeAssignment[]

  // Defaults every study plan of the level inherits; a plan's own non-null value overrides it.
  gradeMetric   GradeMetric? @relation(fields: [gradeMetricId], references: [id], onDelete: SetNull)
  gradeMetricId String?

  @@map("degrees")
}

model StudyPlan {
  id             String          @id @default(cuid())
  name           String
  shortName      String
  level          Int
  degreeId       String
  degree         Degree          @relation(fields: [degreeId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  description    String          @default("")
  schoolId       String
  school         School          @relation(fields: [schoolId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  courses        Course[]
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  classGroups    ClassGroup[]
  // Overrides of the degree's defaults: null inherits the degree's value.
  // Resolve them with study-plans/plan-settings.ts, never by reading these columns alone.
  gradeMetric    GradeMetric?    @relation(fields: [gradeMetricId], references: [id], onDelete: SetNull)
  gradeMetricId  String?
  channels       Channel[]
  feeAssignments FeeAssignment[]

  @@unique([schoolId, name])
  @@map("study_plans")
}

model Course {
  id                 String                     @id @default(cuid())
  name               String
  code               String
  shortName          String
  /// Color tag (ACA-001 BR .11). Null: the UI derives one from the id.
  color              CourseColor?
  /// Private object-storage key of the cover photo (ACA-001 BR .12); null: the color cover.
  coverKey           String?
  /// The teacher's icon for the course (SUBJECT_ICONS, FR-ACA-001.3); null: the subject's icon.
  icon               String?
  organizationId     String
  organization       Organization               @relation(fields: [organizationId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  schoolId           String
  school             School                     @relation(fields: [schoolId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  subjectId          String
  subject            Subject                    @relation(fields: [subjectId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  studyPlanId        String
  studyPlan          StudyPlan                  @relation(fields: [studyPlanId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  createdAt          DateTime                   @default(now())
  updatedAt          DateTime                   @updatedAt
  /// Roster (ACA-001 BR .15). Readers skip `excluded` rows; see courses/course-roster.ts.
  enrollments        CourseEnrollment[]
  teacher            Teacher?                   @relation(fields: [teacherId], references: [id], onDelete: SetNull, onUpdate: Cascade)
  teacherId          String?
  assignments        Assignment[]
  quizzes            Quiz[]
  gradeBuckets       GradeBucket[]
  grades             Grade[]
  weeklySchedules    ClassGroupWeeklySchedule[]
  fileShares         FileShareCourse[]
  attendanceSessions AttendanceSession[]
  channels           Channel[]

  @@unique([schoolId, name])
  @@unique([schoolId, code])
  @@unique([schoolId, subjectId, studyPlanId])
  @@map("courses")
}

/// A student's place on a course roster (ACA-001 BR .15). PLAN rows follow the student's class
/// group's study plan; MANUAL rows are added by an admin (S12) and survive plan sync.
/// `excluded` hides a PLAN row (an exemption) without deleting it.
model CourseEnrollment {
  id        String           @id @default(cuid())
  courseId  String
  course    Course           @relation(fields: [courseId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  studentId String
  student   Student          @relation(fields: [studentId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  source    EnrollmentSource
  excluded  Boolean          @default(false)
  addedById String?
  addedBy   User?            @relation("CourseEnrollmentAddedBy", fields: [addedById], references: [id], onDelete: SetNull, onUpdate: Cascade)
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt

  @@unique([courseId, studentId])
  @@index([studentId])
  @@map("course_enrollments")
}

enum EnrollmentSource {
  PLAN
  MANUAL
}

model ClassGroup {
  id                 String                     @id @default(cuid())
  name               String
  organizationId     String
  organization       Organization               @relation(fields: [organizationId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  schoolId           String
  school             School                     @relation(fields: [schoolId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  studyPlan          StudyPlan                  @relation(fields: [studyPlanId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  active             Boolean
  students           Student[]
  teacher            Teacher?                   @relation(fields: [teacherId], references: [id], onDelete: SetNull, onUpdate: Cascade)
  teacherId          String?
  studyPlanId        String
  assignmentDates    AssignmentDate[]
  quizSchedules      QuizSchedule[]
  quizSubmissions    QuizSubmission[]
  weeklySchedules    ClassGroupWeeklySchedule[]
  fileShares         FileShareClassGroup[]
  attendanceSessions AttendanceSession[]
  habitEvaluations   HabitEvaluation[]
  studentHistory     StudentClassGroupHistory[]
  createdAt          DateTime                   @default(now())
  updatedAt          DateTime                   @updatedAt
  channels           Channel[]

  @@map("class_groups")
}

model Student {
  id                        String                     @id @default(cuid())
  firstName                 String
  middleName                String
  fatherName                String
  motherName                String
  documentId                String
  /// Per-student enrollment/invite code used by parents to self-link (reusable, regenerable)
  enrollmentCode            String?                    @unique
  enrollmentCodeGeneratedAt DateTime?                  @default(now())
  organizationId            String
  organization              Organization               @relation(fields: [organizationId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  school                    School                     @relation(fields: [schoolId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  schoolId                  String
  classGroup                ClassGroup?                @relation(fields: [classGroupId], references: [id], onDelete: SetNull, onUpdate: Cascade)
  classGroupId              String?
  birthDate                 DateTime
  gender                    Gender
  address                   String
  phone                     String
  enrollmentStatus          EnrollmentStatus           @default(ACTIVE)
  bloodType                 String                     @default("")
  allergies                 String                     @default("")
  medicalNotes              String                     @default("")
  emergencyContactName      String                     @default("")
  emergencyContactPhone     String                     @default("")
  courseEnrollments         CourseEnrollment[]
  userId                    String?                    @unique
  user                      User?                      @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  parents                   Parent[]
  createdAt                 DateTime                   @default(now())
  updatedAt                 DateTime                   @updatedAt
  quizSubmissions           QuizSubmission[]
  studentGrades             StudentGrade[]
  attendanceRecords         AttendanceRecord[]
  assignmentSubmissions     AssignmentSubmission[]
  habitEvaluations          StudentHabitEvaluation[]
  charges                   Charge[]
  familyAccountLink         FamilyAccountStudent[]
  classGroupHistory         StudentClassGroupHistory[]
  authTokens                AuthToken[]
  directConversations       DirectConversation[]

  @@map("students")
}

model Parent {
  id             String       @id @default(cuid())
  firstName      String
  middleName     String       @default("")
  fatherName     String
  motherName     String       @default("")
  documentId     String
  phone          String
  email          String
  relationship   String
  occupation     String       @default("")
  workPhone      String       @default("")
  address        String       @default("")
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  students       Student[]
  user           User?        @relation(fields: [userId], references: [id], onDelete: SetNull, onUpdate: Cascade)
  userId         String?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  /// A parent (User) may hold one profile per Organization (federated cross-org identity)
  @@unique([userId, organizationId])
  @@map("parents")
}

model Teacher {
  id                 String              @id @default(cuid())
  firstName          String
  middleName         String
  fatherName         String
  motherName         String
  documentId         String
  organizationId     String
  organization       Organization        @relation(fields: [organizationId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  birthDate          DateTime
  address            String              @default("")
  phoneNumber        String              @default("")
  personalEmail      String              @default("")
  about              String              @default("")
  teacherSince       Int?
  memberSince        DateTime?
  subjects           Subject[]
  gender             Gender
  classGroups        ClassGroup[]
  courses            Course[]
  user               User?               @relation(fields: [userId], references: [id], onDelete: SetNull, onUpdate: Cascade)
  userId             String?             @unique
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt
  assignments        Assignment[]
  quizzes            Quiz[]
  attendanceSessions AttendanceSession[]
  habitEvaluations   HabitEvaluation[]

  @@map("teachers")
}

model Assignment {
  id                String                 @id @default(cuid())
  title             String
  details           String
  type              AssignmentType
  school            School                 @relation(fields: [schoolId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  course            Course                 @relation(fields: [courseId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  date              DateTime
  schoolId          String
  courseId          String
  dates             AssignmentDate[]
  requireSubmission Boolean
  teacher           Teacher?               @relation(fields: [teacherId], references: [id], onDelete: SetNull, onUpdate: Cascade)
  teacherId         String?
  submissions       AssignmentSubmission[]
  /// The grade column linked to it, if any (BR-ASM-001.11).
  grade             Grade?
  /// Its Q&A channel (COM-003 FR .17).
  channel           Channel?
  createdAt         DateTime               @default(now())
  updatedAt         DateTime               @updatedAt

  @@map("assignments")
}

model AssignmentSubmission {
  id           String     @id @default(cuid())
  assignmentId String
  assignment   Assignment @relation(fields: [assignmentId], references: [id], onDelete: Cascade)
  studentId    String
  student      Student    @relation(fields: [studentId], references: [id], onDelete: Cascade)
  fileId       String
  file         File       @relation(fields: [fileId], references: [id], onDelete: Cascade)
  submittedAt  DateTime   @default(now())
  /// Set when the course's teacher (or an admin) marks it reviewed; null = "por revisar" (BR-HOM-001.17).
  reviewedAt   DateTime?
  updatedAt    DateTime   @updatedAt

  @@unique([assignmentId, studentId])
  @@index([assignmentId])
  @@index([studentId])
  @@index([assignmentId, reviewedAt])
  @@map("assignment_submissions")
}

model AssignmentDate {
  id           String     @id @default(cuid())
  date         DateTime
  assignment   Assignment @relation(fields: [assignmentId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  assignmentId String
  classGroup   ClassGroup @relation(fields: [classGroupId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  classGroupId String

  @@map("assignment_dates")
}

model Quiz {
  id              String           @id @default(cuid())
  title           String
  details         String
  organization    Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  organizationId  String
  course          Course           @relation(fields: [courseId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  courseId        String
  teacher         Teacher?         @relation(fields: [teacherId], references: [id], onDelete: SetNull, onUpdate: Cascade)
  teacherId       String?
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  questions       QuizQuestion[]
  schedules       QuizSchedule[]
  quizSubmissions QuizSubmission[]

  @@map("quizzes")
}

model QuizQuestion {
  id                  String                   @id @default(cuid())
  question            String
  quiz                Quiz                     @relation(fields: [quizId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  quizId              String
  value               Decimal
  type                QuizQuestionType
  options             QuizQuestionOption[]
  submissionQuestions QuizSubmissionQuestion[]
  timeLimit           Int?

  @@map("quiz_questions")
}

model QuizQuestionOption {
  id                  String                   @id @default(cuid())
  option              String
  question            QuizQuestion             @relation(fields: [questionId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  questionId          String
  isCorrect           Boolean
  submissionQuestions QuizSubmissionQuestion[]

  @@map("quiz_question_options")
}

model QuizSchedule {
  id           String     @id @default(cuid())
  quiz         Quiz       @relation(fields: [quizId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  quizId       String
  classGroup   ClassGroup @relation(fields: [classGroupId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  classGroupId String
  startDate    DateTime
  dueDate      DateTime
  published    Boolean
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  @@map("quiz_schedules")
}

model ClassGroupWeeklySchedule {
  id           String     @id @default(cuid())
  classGroup   ClassGroup @relation(fields: [classGroupId], references: [id], onDelete: Cascade)
  classGroupId String
  course       Course     @relation(fields: [courseId], references: [id], onDelete: Cascade)
  courseId     String
  location     String     @default("")
  remote       Boolean    @default(false)
  remoteLink   String     @default("")
  recess       Boolean    @default(false)
  weekday      WeekDay
  startTime    String // Format: "HH:mm" (e.g., "09:00", "14:30")
  endTime      String // Format: "HH:mm" (e.g., "10:30", "16:00")
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  @@unique([classGroupId, courseId, weekday, startTime])
  @@map("class_group_weekly_schedules")
}

model QuizSubmission {
  id                  String                   @id @default(cuid())
  quiz                Quiz                     @relation(fields: [quizId], references: [id])
  quizId              String
  student             Student                  @relation(fields: [studentId], references: [id])
  studentId           String
  classGroup          ClassGroup               @relation(fields: [classGroupId], references: [id])
  classGroupId        String
  submissionQuestions QuizSubmissionQuestion[]
  score               Decimal
  createdAt           DateTime                 @default(now())
  updatedAt           DateTime                 @updatedAt

  @@map("quiz_submissions")
}

model QuizSubmissionQuestion {
  id               String               @id @default(cuid())
  quizSubmission   QuizSubmission       @relation(fields: [quizSubmissionId], references: [id])
  quizSubmissionId String
  quizQuestion     QuizQuestion         @relation(fields: [quizQuestionId], references: [id])
  quizQuestionId   String
  answer           String
  options          QuizQuestionOption[]
  isCorrect        Boolean
  score            Decimal
  comment          String?

  @@map("quiz_submission_questions")
}

model GradeMetric {
  id                String      @id @default(cuid())
  name              String
  minimum           Decimal
  maximum           Decimal
  minimumApproval   Decimal
  minimumExcellence Decimal
  createdAt         DateTime    @default(now())
  updatedAt         DateTime    @updatedAt
  studyPlans        StudyPlan[]
  degrees           Degree[]

  @@map("grade_metrics")
}

model GradeBucket {
  id        String   @id @default(cuid())
  name      String
  weight    Decimal
  courseId  String
  course    Course   @relation(fields: [courseId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  grades    Grade[]

  @@map("grade_buckets")
}

model Grade {
  id            String         @id @default(cuid())
  title         String
  comments      String?
  courseId      String
  course        Course         @relation(fields: [courseId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  bucketId      String
  bucket        GradeBucket    @relation(fields: [bucketId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  periodId      String
  period        Period         @relation(fields: [periodId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  date          DateTime
  published     Boolean        @default(false)
  /// When and by whom the column was published (BR-ASM-001.9); cleared when an admin unpublishes.
  publishedAt   DateTime?
  publishedById String?
  publishedBy   User?          @relation("GradePublishedBy", fields: [publishedById], references: [id], onDelete: SetNull, onUpdate: Cascade)
  /// The assignment this column grades (BR-ASM-001.11): same course, at most one column per assignment.
  assignmentId  String?        @unique
  assignment    Assignment?    @relation(fields: [assignmentId], references: [id], onDelete: SetNull, onUpdate: Cascade)
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  studentGrades StudentGrade[]

  @@map("grades")
}

model StudentGrade {
  id        String                 @id @default(cuid())
  comments  String?
  gradeId   String
  grade     Grade                  @relation(fields: [gradeId], references: [id], onDelete: Cascade)
  studentId String
  student   Student                @relation(fields: [studentId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  score     Decimal?
  /// Excused (ASM-001 BR .3): no score, left out of every average. Never set together with a score.
  excused   Boolean                @default(false)
  createdAt DateTime               @default(now())
  updatedAt DateTime               @updatedAt
  revisions StudentGradeRevision[]

  /// One cell per student and grade column (ASM-001 BR .10).
  @@unique([gradeId, studentId])
  @@map("student_grades")
}

/// A change to a published score (BR-ASM-001.8). Never edited or deleted.
model StudentGradeRevision {
  id             String       @id @default(cuid())
  /// Required, 3–300 characters (BR-ASM-001.8).
  reason         String
  studentGradeId String
  studentGrade   StudentGrade @relation(fields: [studentGradeId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  previousScore  Decimal?
  /// The new score; null when the score was cleared (or, from S05, excused).
  score          Decimal?
  excused        Boolean      @default(false)
  changedById    String?
  changedBy      User?        @relation("StudentGradeRevisionChangedBy", fields: [changedById], references: [id], onDelete: SetNull, onUpdate: Cascade)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@index([studentGradeId, createdAt])
  @@map("student_grade_revisions")
}

// ==========================================
// Join Requests & Notifications
// ==========================================

model JoinRequest {
  id            String            @id @default(cuid())
  user          User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId        String
  school        School            @relation(fields: [schoolId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  schoolId      String
  requestedRole String // 'ORG_ADMIN', 'TEACHER', 'PARENT'
  documentId    String?
  status        JoinRequestStatus @default(PENDING)
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt

  @@unique([userId, schoolId])
  @@map("join_requests")
}

enum OnboardingAuditAction {
  REQUEST_JOIN_SCHOOL
  LINK_CHILD
  VERIFY_STUDENT
  APPROVE_JOIN_REQUEST
  REJECT_JOIN_REQUEST
  RESEND_INVITATION
  INVITATION_CREATED
  INVITATION_EMAIL_FAILED
  ENROLLMENT_CODE_REGENERATED
  MAGIC_LINK_ISSUED
  MAGIC_LINK_CONSUMED
  MAGIC_LINK_REJECTED
  CHILD_CONNECT_ISSUED
  CHILD_CONNECT_CONSUMED
  CHILD_CONNECT_REJECTED
  BULK_IMPORT_COMMITTED
  CLASS_GROUP_CHANGED
}

enum AuthTokenType {
  MAGIC_LINK
  CHILD_CONNECT
}

enum ImportEntityType {
  STUDENT
  TEACHER
}

enum ImportJobStatus {
  DRY_RUN
  COMMITTED
  FAILED
}

model AuthToken {
  id               String        @id @default(cuid())
  type             AuthTokenType
  tokenHash        String        @unique
  userId           String?
  user             User?         @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  studentId        String?
  student          Student?      @relation(fields: [studentId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  organizationId   String?
  organization     Organization? @relation(fields: [organizationId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  metadata         Json?
  expiresAt        DateTime
  consumedAt       DateTime?
  consumedByUserId String?
  createdById      String?
  attempts         Int           @default(0)
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt

  @@index([type, expiresAt])
  @@index([userId])
  @@index([studentId])
  @@map("auth_tokens")
}

model StudentClassGroupHistory {
  id             String       @id @default(cuid())
  studentId      String
  student        Student      @relation(fields: [studentId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  // Nullable so a deleted class group does not destroy the audit trail: the
  // FK is `SetNull`, which would otherwise violate NOT NULL on delete.
  classGroupId   String?
  classGroup     ClassGroup?  @relation(fields: [classGroupId], references: [id], onDelete: SetNull, onUpdate: Cascade)
  schoolId       String
  school         School       @relation(fields: [schoolId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  startedAt      DateTime     @default(now())
  endedAt        DateTime?
  reason         String?
  createdById    String?
  createdAt      DateTime     @default(now())

  @@index([studentId, startedAt])
  @@index([classGroupId])
  @@map("student_class_group_history")
}

model ImportJob {
  id             String           @id @default(cuid())
  organizationId String
  organization   Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  schoolId       String
  school         School           @relation(fields: [schoolId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  entityType     ImportEntityType
  status         ImportJobStatus  @default(DRY_RUN)
  createdById    String?
  totalRows      Int              @default(0)
  createdCount   Int              @default(0)
  updatedCount   Int              @default(0)
  errorCount     Int              @default(0)
  errors         Json?
  completedAt    DateTime?
  createdAt      DateTime         @default(now())

  @@index([organizationId])
  @@map("import_jobs")
}

model OnboardingAuditLog {
  id             String                @id @default(cuid())
  actorId        String? // user who performed the action (admin or the user themselves)
  userId         String? // affected user
  organizationId String?
  action         OnboardingAuditAction
  detail         String?
  ip             String?
  createdAt      DateTime              @default(now())

  @@index([userId])
  @@index([organizationId])
  @@index([action])
  @@map("onboarding_audit_logs")
}

model InvitationStatus {
  userId    String   @id
  status    String // 'PENDING' | 'SENT' | 'FAILED'
  detail    String?
  updatedAt DateTime @updatedAt

  @@map("invitation_status")
}

model Notification {
  id          String   @id @default(cuid())
  recipient   User     @relation(fields: [recipientId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  recipientId String
  type        String // 'JOIN_REQUEST', 'REQUEST_APPROVED', 'REQUEST_REJECTED'
  title       String
  message     String
  read        Boolean  @default(false)
  relatedId   String?
  createdAt   DateTime @default(now())

  @@index([recipientId])
  @@map("notifications")
}

// per-recipient, per-channel receipt — the read-receipt source of truth mirror

// ==========================================
// Communication (COM-003): channels and direct messages
// ==========================================

/// The level a channel addresses (COM-003 FR .1). The matching target id is set on the channel.
enum ChannelScope {
  ORGANIZATION
  SCHOOL
  STUDY_PLAN
  CLASS_GROUP
  COURSE
  /// An assignment's Q&A channel, created with it (COM-003 FR .17).
  ASSIGNMENT
}

/// Who sees a member's replies (COM-003 FR .4 / BR .5).
enum ChannelReplyVisibility {
  /// Every member and manager sees every reply.
  PUBLIC
  /// Each member's replies are a private conversation with the channel's managers.
  PRIVATE
}

/// One-to-many communication at one level of the school (COM-003). Membership is computed live
/// from the level and the audience flags (BR .4), so there is no member table.
model Channel {
  id               String                 @id @default(cuid())
  organizationId   String
  organization     Organization           @relation(fields: [organizationId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  scope            ChannelScope
  /// Set for every scope below ORGANIZATION, so channels can be filtered by school.
  schoolId         String?
  school           School?                @relation(fields: [schoolId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  studyPlanId      String?
  studyPlan        StudyPlan?             @relation(fields: [studyPlanId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  classGroupId     String?
  classGroup       ClassGroup?            @relation(fields: [classGroupId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  courseId         String?
  course           Course?                @relation(fields: [courseId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  /// ASSIGNMENT channels: their assignment, at most one channel each (COM-003 BR .10). Also sets courseId.
  assignmentId     String?                @unique
  assignment       Assignment?            @relation(fields: [assignmentId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  /// ASSIGNMENT channels close 3 days after the assignment's latest date (COM-003 BR .11).
  closesAt         DateTime?
  name             String
  description      String                 @default("")
  audienceStudents Boolean                @default(true)
  audienceParents  Boolean                @default(true)
  studentsCanReply Boolean                @default(false)
  parentsCanReply  Boolean                @default(false)
  replyVisibility  ChannelReplyVisibility @default(PRIVATE)
  createdById      String?
  createdBy        User?                  @relation("ChannelCreatedBy", fields: [createdById], references: [id], onDelete: SetNull, onUpdate: Cascade)
  archivedAt       DateTime?
  createdAt        DateTime               @default(now())
  updatedAt        DateTime               @updatedAt
  posts            ChannelPost[]

  @@index([organizationId, scope])
  @@index([schoolId])
  @@index([studyPlanId])
  @@index([classGroupId])
  @@index([courseId])
  @@map("channels")
}

model ChannelPost {
  id                   String                @id @default(cuid())
  channelId            String
  channel              Channel               @relation(fields: [channelId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  authorId             String?
  author               User?                 @relation(fields: [authorId], references: [id], onDelete: SetNull, onUpdate: Cascade)
  body                 String
  /// Members are asked to press "Confirmar lectura" (COM-003 FR .6 / .8).
  requiresConfirmation Boolean               @default(false)
  /// The opening post of an ASSIGNMENT channel, shown first (COM-003 FR .17).
  pinned               Boolean               @default(false)
  createdAt            DateTime              @default(now())
  deletedAt            DateTime?
  replies              ChannelReply[]
  reads                ChannelPostRead[]
  reminders            ChannelPostReminder[]

  @@index([channelId, createdAt])
  @@map("channel_posts")
}

model ChannelReply {
  id           String      @id @default(cuid())
  postId       String
  post         ChannelPost @relation(fields: [postId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  authorId     String?
  author       User?       @relation("ChannelReplyAuthor", fields: [authorId], references: [id], onDelete: SetNull, onUpdate: Cascade)
  /// PRIVATE channels: the member whose conversation this reply belongs to. Null in PUBLIC channels.
  threadUserId String?
  threadUser   User?       @relation("ChannelReplyThread", fields: [threadUserId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  body         String
  createdAt    DateTime    @default(now())
  deletedAt    DateTime?

  @@index([postId, threadUserId])
  @@map("channel_replies")
}

/// A member's read (and optional confirmation) of a post (COM-003 FR .8 / .9).
model ChannelPostRead {
  postId      String
  post        ChannelPost @relation(fields: [postId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  userId      String
  user        User        @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  readAt      DateTime    @default(now())
  confirmedAt DateTime?

  @@id([postId, userId])
  @@index([userId])
  @@map("channel_post_reads")
}

/// COM-003 FR .21, BR .15: the one email reminder a member got to confirm a post; never sent twice.
model ChannelPostReminder {
  id     String      @id @default(cuid())
  postId String
  post   ChannelPost @relation(fields: [postId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  userId String
  user   User        @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  sentAt DateTime    @default(now())

  @@unique([postId, userId])
  @@map("channel_post_reminders")
}

/// One-to-one conversation started by staff with a parent, optionally about one child (COM-003 FR .12).
model DirectConversation {
  id               String                     @id @default(cuid())
  organizationId   String
  organization     Organization               @relation(fields: [organizationId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  staffUserId      String
  staffUser        User                       @relation("DirectStaff", fields: [staffUserId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  parentUserId     String
  parentUser       User                       @relation("DirectParent", fields: [parentUserId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  studentId        String?
  student          Student?                   @relation(fields: [studentId], references: [id], onDelete: SetNull, onUpdate: Cascade)
  staffLastReadAt  DateTime?
  parentLastReadAt DateTime?
  lastMessageAt    DateTime                   @default(now())
  createdAt        DateTime                   @default(now())
  messages         DirectMessage[]
  reports          DirectConversationReport[]
  accesses         DirectConversationAccess[]

  @@index([staffUserId, lastMessageAt])
  @@index([parentUserId, lastMessageAt])
  @@index([studentId])
  @@map("direct_conversations")
}

model DirectMessage {
  id             String             @id @default(cuid())
  conversationId String
  conversation   DirectConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  senderId       String?
  sender         User?              @relation(fields: [senderId], references: [id], onDelete: SetNull, onUpdate: Cascade)
  body           String
  createdAt      DateTime           @default(now())

  @@index([conversationId, createdAt])
  @@map("direct_messages")
}

/// COM-003 FR .20, BR .14: a participant reports a direct conversation; admins then review it read-only.
model DirectConversationReport {
  id             String             @id @default(cuid())
  conversationId String
  conversation   DirectConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  reportedById   String
  reportedBy     User               @relation("DirectReportBy", fields: [reportedById], references: [id], onDelete: Cascade, onUpdate: Cascade)
  reason         String
  createdAt      DateTime           @default(now())
  resolvedAt     DateTime?
  resolvedById   String?
  resolvedBy     User?              @relation("DirectReportResolver", fields: [resolvedById], references: [id], onDelete: SetNull, onUpdate: Cascade)
  resolution     String?

  @@index([conversationId, resolvedAt])
  @@map("direct_conversation_reports")
}

/// COM-003 BR .14: every time an admin opens a reported conversation. Kept after the report is resolved.
model DirectConversationAccess {
  id             String             @id @default(cuid())
  conversationId String
  conversation   DirectConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  adminUserId    String
  adminUser      User               @relation(fields: [adminUserId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  accessedAt     DateTime           @default(now())

  @@index([conversationId, accessedAt])
  @@map("direct_conversation_accesses")
}

// ==========================================
// Financial
// ==========================================

// ==========================================
// Finance (FIN-001)
// ==========================================

/// One family account per (school, family): it holds the charges of the family's students in that
/// school (BR-FIN-001.1). Its guardians are the parents linked to its students.
model FamilyAccount {
  id             String                 @id @default(cuid())
  organizationId String
  organization   Organization           @relation(fields: [organizationId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  schoolId       String
  school         School                 @relation(fields: [schoolId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  /// Sequential per school; shown as C-0001.
  number         Int
  /// Saldo a favor; a cache of the sum of the account's credit entries (FR-FIN-001.17).
  creditBalance  Decimal                @default(0) @db.Decimal(12, 2)
  students       FamilyAccountStudent[]
  charges        Charge[]
  payments       Payment[]
  creditEntries  CreditEntry[]
  createdAt      DateTime               @default(now())
  updatedAt      DateTime               @updatedAt

  @@unique([schoolId, number])
  @@index([organizationId, schoolId])
  @@map("family_accounts")
}

/// A student belongs to exactly one family account per school.
model FamilyAccountStudent {
  id        String        @id @default(cuid())
  accountId String
  account   FamilyAccount @relation(fields: [accountId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  studentId String
  student   Student       @relation(fields: [studentId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  schoolId  String
  createdAt DateTime      @default(now())

  @@unique([studentId, schoolId])
  @@index([accountId])
  @@map("family_account_students")
}

enum ChargeSource {
  FEE
  MANUAL
  LATE_FEE
  STORE_ORDER
}

/// A charge on a family account. Status is derived (BR-FIN-001.10), never stored: see
/// finance/charge-status.ts. Charges are never deleted; they are cancelled with a reason.
model Charge {
  id             String              @id @default(cuid())
  organizationId String
  organization   Organization        @relation(fields: [organizationId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  schoolId       String
  school         School              @relation(fields: [schoolId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  accountId      String
  account        FamilyAccount       @relation(fields: [accountId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  /// Null for account-level charges (store orders).
  studentId      String?
  student        Student?            @relation(fields: [studentId], references: [id], onDelete: SetNull, onUpdate: Cascade)
  year           Int
  source         ChargeSource        @default(MANUAL)
  description    String
  grossAmount    Decimal             @db.Decimal(12, 2)
  discountAmount Decimal             @default(0) @db.Decimal(12, 2)
  netAmount      Decimal             @db.Decimal(12, 2)
  /// Sum of active payment allocations (kept in step by the payments service).
  paidAmount     Decimal             @default(0) @db.Decimal(12, 2)
  /// Generated charges (source FEE): the catalog item and installment (1-based) they come from.
  feeItemId      String?
  feeItem        FeeItem?            @relation(fields: [feeItemId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  installment    Int?
  allocations    PaymentAllocation[]
  creditEntries  CreditEntry[]
  dueDate        DateTime            @db.Date
  createdById    String?
  cancelledAt    DateTime?
  cancelledById  String?
  cancelReason   String?
  createdAt      DateTime            @default(now())
  updatedAt      DateTime            @updatedAt

  @@unique([studentId, feeItemId, year, installment])
  @@index([organizationId, schoolId, dueDate])
  @@index([accountId])
  @@index([studentId])
  @@map("charges")
}

enum FeeKind {
  ENROLLMENT
  TUITION
  OTHER
}

enum FeeSchedule {
  ONE_TIME
  MONTHLY
}

/// A school's fee catalog item (FR-FIN-001.4). Months are resolved to dates per academic year by
/// finance/fee-schedule.ts: a month >= the school's schoolYearStartMonth is in that year, earlier
/// months in the next one.
model FeeItem {
  id          String          @id @default(cuid())
  schoolId    String
  school      School          @relation(fields: [schoolId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  name        String
  kind        FeeKind
  amount      Decimal         @db.Decimal(12, 2)
  schedule    FeeSchedule
  /// ONE_TIME: month of the due date (1-12).
  dueMonth    Int?
  /// MONTHLY: first and last month (1-12), in school-year order.
  startMonth  Int?
  endMonth    Int?
  /// Day of month the charge is due, clamped to the month's last day.
  dueDay      Int
  active      Boolean         @default(true)
  assignments FeeAssignment[]
  charges     Charge[]
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  @@unique([schoolId, name])
  @@map("fee_items")
}

/// A fee item applied to a degree (all its study plans) or to one study plan, for a year
/// (FR-FIN-001.5). A study plan's assignment overrides the degree's for the same item (BR-FIN-001.4).
model FeeAssignment {
  id             String     @id @default(cuid())
  feeItemId      String
  feeItem        FeeItem    @relation(fields: [feeItemId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  year           Int
  degreeId       String?
  degree         Degree?    @relation(fields: [degreeId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  studyPlanId    String?
  studyPlan      StudyPlan? @relation(fields: [studyPlanId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  /// Null: the item's amount.
  amountOverride Decimal?   @db.Decimal(12, 2)
  createdAt      DateTime   @default(now())

  @@unique([feeItemId, year, degreeId])
  @@unique([feeItemId, year, studyPlanId])
  @@index([year])
  @@map("fee_assignments")
}

enum PaymentMethod {
  CARD
  BANK_TRANSFER
  YAPPY
  CREDIT
}

enum PaymentStatus {
  PENDING
  COMPLETED
  FAILED
  VOIDED
}

/// Money received on a family account (FR-FIN-001.13, .14). Never deleted: wrong payments are
/// voided (FR-FIN-001.16).
model Payment {
  id             String              @id @default(cuid())
  organizationId String
  organization   Organization        @relation(fields: [organizationId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  schoolId       String
  school         School              @relation(fields: [schoolId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  accountId      String
  account        FamilyAccount       @relation(fields: [accountId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  method         PaymentMethod
  status         PaymentStatus
  amount         Decimal             @db.Decimal(12, 2)
  /// The day the money was received (school-local).
  receivedAt     DateTime            @db.Date
  /// Transfer number or Yappy transaction id (BR-FIN-001.14); card payments: the provider reference.
  reference      String?
  note           String?
  cardBrand      String?
  cardLast4      String?
  provider       String?
  providerRef    String?
  idempotencyKey String?             @unique
  /// Sequential per school with no gaps (BR-FIN-001.16), shown as R-000123.
  receiptNumber  Int?
  payerUserId    String?
  createdById    String?
  voidedAt       DateTime?
  voidedById     String?
  voidReason     String?
  /// Card payments: the provider's refund reference when voided (FR-FIN-001.16; mocked in v1).
  refundRef      String?
  allocations    PaymentAllocation[]
  creditEntries  CreditEntry[]
  createdAt      DateTime            @default(now())
  updatedAt      DateTime            @updatedAt

  @@unique([schoolId, receiptNumber])
  @@index([schoolId, method, reference])
  @@index([accountId])
  @@index([organizationId, schoolId, receivedAt])
  @@map("payments")
}

/// The part of a payment applied to one charge. Reversed (never deleted) when the payment is voided.
model PaymentAllocation {
  id         String    @id @default(cuid())
  paymentId  String
  payment    Payment   @relation(fields: [paymentId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  chargeId   String
  charge     Charge    @relation(fields: [chargeId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  amount     Decimal   @db.Decimal(12, 2)
  reversedAt DateTime?
  createdAt  DateTime  @default(now())

  @@index([paymentId])
  @@index([chargeId])
  @@map("payment_allocations")
}

/// Saldo a favor movements: + generated by a payment, − applied to a charge, ± reversals.
model CreditEntry {
  id          String        @id @default(cuid())
  accountId   String
  account     FamilyAccount @relation(fields: [accountId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  paymentId   String?
  payment     Payment?      @relation(fields: [paymentId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  chargeId    String?
  charge      Charge?       @relation(fields: [chargeId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  amount      Decimal       @db.Decimal(12, 2)
  reason      String
  createdById String?
  createdAt   DateTime      @default(now())

  @@index([accountId])
  @@map("credit_entries")
}

/// Per-school finance settings. S03 adds the receipt sequence; late fees and reminders come later.
model FinanceSettings {
  id         String   @id @default(cuid())
  schoolId   String   @unique
  school     School   @relation(fields: [schoolId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  /// Last receipt number used (BR-FIN-001.16).
  receiptSeq Int      @default(0)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@map("finance_settings")
}

/// Who changed what in finance (FIN-001 §5).
model FinanceAuditLog {
  id             String   @id @default(cuid())
  organizationId String
  schoolId       String
  actorId        String?
  action         String
  entity         String
  entityId       String
  payload        Json?
  createdAt      DateTime @default(now())

  @@index([organizationId, schoolId, createdAt])
  @@index([entity, entityId])
  @@map("finance_audit_logs")
}

// ==========================================
// Better-Auth Tables
// ==========================================

model Session {
  id                   String   @id
  expiresAt            DateTime
  token                String   @unique
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt
  ipAddress            String?
  userAgent            String?
  userId               String
  user                 User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  activeOrganizationId String?

  @@index([userId])
  @@map("sessions")
}

model Account {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@index([userId])
  @@map("accounts")
}

model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
  @@map("verifications")
}

model Member {
  id             String       @id
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  userId         String
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  role           String       @default("member")
  createdAt      DateTime     @default(now())

  @@unique([organizationId, userId])
  @@index([userId])
  @@map("members")
}

model Invitation {
  id             String       @id
  email          String
  inviterId      String
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  role           String
  status         String       @default("pending")
  expiresAt      DateTime
  createdAt      DateTime     @default(now())

  @@index([organizationId])
  @@index([email])
  @@map("invitations")
}

