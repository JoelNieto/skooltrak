// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider     = "prisma-client"
  output       = "../generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

model Organization {
  id                  String              @id @default(cuid())
  name                String
  slug                String?             @unique
  logo                String?
  metadata            String?
  description         String
  active              Boolean             @default(true)
  onboardingCompleted Boolean             @default(false)
  users               User[]
  roles               Role[]
  schools             School[]
  subjects            Subject[]
  createdAt           DateTime            @default(now())
  updatedAt           DateTime            @updatedAt
  groups              ClassGroup[]
  courses             Course[]
  Teacher             Teacher[]
  Student             Student[]
  Parent              Parent[]
  quizzes             Quiz[]
  messages            Message[]
  files               File[]
  attendanceSessions  AttendanceSession[]
  newsletters         Newsletter[]
  habitEvaluations    HabitEvaluation[]
  chats               Chat[]
  // Better-auth organization plugin
  members             Member[]
  invitations         Invitation[]
  importJobs          ImportJob[]
  authTokens          AuthToken[]
  studentClassGroupHistory StudentClassGroupHistory[]

  @@map("organizations")
}

model User {
  id                String             @id @default(cuid())
  email             String             @unique
  name              String?
  firstName         String
  lastName          String
  password          String
  color             String?
  image             String?
  emailVerified     Boolean            @default(false)
  banned            Boolean            @default(false)
  banReason         String?
  banExpires        DateTime?
  role              Role?              @relation(fields: [roleId], references: [id])
  roleId            String?
  organization      Organization?      @relation(fields: [organizationId], references: [id], onDelete: SetNull, onUpdate: Cascade)
  organizationId    String?
  onboardingStep    String? // 'choose-path', 'school-setup', 'waiting-approval', 'completed'
  themePreference   String? // 'light' | 'dark' | 'system'
  lastLogin         DateTime?
  isBlocked         Boolean            @default(false)
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt
  student           Student?
  teacher           Teacher?
  parents           Parent[]
  sentMessages      Message[]
  messageRecipients MessageRecipient[]
  filesOwned        File[]
  fileShares        FileShareUser[]
  notifications     Notification[]
  joinRequests      JoinRequest[]
  newsletters       Newsletter[]
  chatParticipants  ChatParticipant[]
  sentChatMessages  ChatMessage[]
  createdChats      Chat[]
  storeCartItems    StoreCartItem[]
  storeOrders       StoreOrder[]
  // Better-auth relations
  sessions          Session[]
  accounts          Account[]
  members           Member[]
  authTokens        AuthToken[]

  @@map("users")
}

model Message {
  id              String             @id @default(cuid())
  subject         String
  content         String
  organization    Organization       @relation(fields: [organizationId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  organizationId  String
  sender          User?              @relation(fields: [senderId], references: [id], onDelete: SetNull, onUpdate: Cascade)
  senderId        String?
  recipients      MessageRecipient[]
  parentMessageId String?
  parentMessage   Message?           @relation("MessageReplies", fields: [parentMessageId], references: [id], onDelete: Cascade)
  replies         Message[]          @relation("MessageReplies")
  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt
  deletedAt       DateTime?

  @@map("messages")
}

model MessageRecipient {
  id        String    @id @default(cuid())
  messageId String
  userId    String
  message   Message   @relation(fields: [messageId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  readAt    DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  @@unique([messageId, userId])
  @@map("message_recipients")
}

// ==========================================
// Instant Messaging (Chat)
// ==========================================

enum ChatType {
  DIRECT
  GROUP
  COURSE
  ASSIGNMENT
  CLASS_GROUP
}

enum ChatParticipantRole {
  MEMBER
  ADMIN
}

model Chat {
  id             String            @id @default(cuid())
  organizationId String
  organization   Organization      @relation(fields: [organizationId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  name           String?
  type           ChatType
  courseId       String?
  course         Course?           @relation(fields: [courseId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  assignmentId   String?
  assignment     Assignment?       @relation(fields: [assignmentId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  classGroupId   String?
  classGroup     ClassGroup?       @relation(fields: [classGroupId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  createdById    String?
  createdBy      User?             @relation(fields: [createdById], references: [id], onDelete: SetNull, onUpdate: Cascade)
  participants   ChatParticipant[]
  messages       ChatMessage[]
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt
  deletedAt      DateTime?

  @@index([organizationId])
  @@index([courseId])
  @@index([assignmentId])
  @@index([classGroupId])
  @@map("chats")
}

model ChatParticipant {
  id         String              @id @default(cuid())
  chatId     String
  chat       Chat                @relation(fields: [chatId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  userId     String
  user       User                @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  role       ChatParticipantRole @default(MEMBER)
  joinedAt   DateTime            @default(now())
  lastReadAt DateTime?
  createdAt  DateTime            @default(now())
  updatedAt  DateTime            @updatedAt

  @@unique([chatId, userId])
  @@index([userId])
  @@map("chat_participants")
}

model ChatMessage {
  id        String        @id @default(cuid())
  chatId    String
  chat      Chat          @relation(fields: [chatId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  senderId  String?
  sender    User?         @relation(fields: [senderId], references: [id], onDelete: SetNull, onUpdate: Cascade)
  content   String
  replyToId String?
  replyTo   ChatMessage?  @relation("ChatMessageReplies", fields: [replyToId], references: [id], onDelete: SetNull, onUpdate: Cascade)
  replies   ChatMessage[] @relation("ChatMessageReplies")
  createdAt DateTime      @default(now())
  deletedAt DateTime?

  @@index([chatId])
  @@index([senderId])
  @@map("chat_messages")
}

model File {
  id                    String                 @id @default(cuid())
  organizationId        String
  organization          Organization           @relation(fields: [organizationId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  ownerId               String?
  owner                 User?                  @relation(fields: [ownerId], references: [id], onDelete: SetNull, onUpdate: Cascade)
  name                  String
  mimeType              String
  size                  Int
  storageKey            String
  sharesUsers           FileShareUser[]
  sharesSchools         FileShareSchool[]
  sharesClassGroups     FileShareClassGroup[]
  sharesCourses         FileShareCourse[]
  assignmentSubmissions AssignmentSubmission[]
  createdAt             DateTime               @default(now())
  updatedAt             DateTime               @updatedAt
  deletedAt             DateTime?

  @@index([organizationId])
  @@index([ownerId])
  @@map("files")
}

model FileShareUser {
  id         String         @id @default(cuid())
  fileId     String
  file       File           @relation(fields: [fileId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  userId     String
  user       User           @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  permission FilePermission
  createdAt  DateTime       @default(now())
  updatedAt  DateTime       @updatedAt

  @@unique([fileId, userId])
  @@index([userId])
  @@map("file_share_users")
}

model FileShareSchool {
  id         String         @id @default(cuid())
  fileId     String
  file       File           @relation(fields: [fileId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  schoolId   String
  school     School         @relation(fields: [schoolId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  permission FilePermission
  createdAt  DateTime       @default(now())
  updatedAt  DateTime       @updatedAt

  @@unique([fileId, schoolId])
  @@index([schoolId])
  @@map("file_share_schools")
}

model FileShareClassGroup {
  id           String         @id @default(cuid())
  fileId       String
  file         File           @relation(fields: [fileId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  classGroupId String
  classGroup   ClassGroup     @relation(fields: [classGroupId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  permission   FilePermission
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt

  @@unique([fileId, classGroupId])
  @@index([classGroupId])
  @@map("file_share_class_groups")
}

model FileShareCourse {
  id         String         @id @default(cuid())
  fileId     String
  file       File           @relation(fields: [fileId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  courseId   String
  course     Course         @relation(fields: [courseId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  permission FilePermission
  createdAt  DateTime       @default(now())
  updatedAt  DateTime       @updatedAt

  @@unique([fileId, courseId])
  @@index([courseId])
  @@map("file_share_courses")
}

model Role {
  id             String        @id @default(cuid())
  name           String
  description    String
  users          User[]
  permissions    Permission[]
  organization   Organization? @relation(fields: [organizationId], references: [id])
  organizationId String?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  @@unique([organizationId, name])
  @@map("roles")
}

model Permission {
  id            String   @id @default(cuid())
  descriptiveId String   @unique
  description   String
  roles         Role[]
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@map("permissions")
}

model School {
  id             String            @id @default(cuid())
  organization   Organization      @relation(fields: [organizationId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  organizationId String
  /// Public URL segment for the school store (e.g. /store/my-school)
  slug           String?           @unique
  name           String
  shortName      String
  logo           String
  currencyCode   String            @default("USD")
  address        String
  city           String
  state          String
  zip            String
  country        String
  email          String
  phone          String
  website        String
  primaryColor   String?
  secondaryColor String?
  tertiaryColor  String?
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt
  studyPlans     StudyPlan[]
  degrees        Degree[]
  courses        Course[]
  classGroups    ClassGroup[]
  students       Student[]
  studentClassGroupHistory StudentClassGroupHistory[]
  assignments    Assignment[]
  currentYear    Int               @default(2025)
  fileShares     FileShareSchool[]
  joinRequests   JoinRequest[]
  newsletters    Newsletter[]
  charges        Charge[]
  storeCategories StoreCategory[]
  storeProducts   StoreProduct[]
  storeOrders     StoreOrder[]
  importJobs      ImportJob[]

  @@map("schools")
}

model Period {
  id               String            @id @default(cuid())
  name             String
  shortName        String            @default("")
  year             Int
  startDate        DateTime
  endDate          DateTime
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
  grades           Grade[]
  habitEvaluations HabitEvaluation[]

  @@index([year, name])
  @@index([year, shortName])
  @@map("periods")
}

model Subject {
  id             String       @id @default(cuid())
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  organizationId String
  name           String
  code           String
  courses        Course[]
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  teachers       Teacher[]

  @@unique([organizationId, name, code])
  @@map("subjects")
}

model Degree {
  id         String      @id @default(cuid())
  name       String
  shortName  String
  schoolId   String
  school     School      @relation(fields: [schoolId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  createdAt  DateTime    @default(now())
  updatedAt  DateTime    @updatedAt
  studyPlans StudyPlan[]

  @@map("degrees")
}

model StudyPlan {
  id                   String                    @id @default(cuid())
  name                 String
  shortName            String
  level                Int
  degreeId             String
  degree               Degree                    @relation(fields: [degreeId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  description          String
  schoolId             String
  school               School                    @relation(fields: [schoolId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  courses              Course[]
  createdAt            DateTime                  @default(now())
  updatedAt            DateTime                  @updatedAt
  classGroups          ClassGroup[]
  charges              Charge[]
  gradeMetric          GradeMetric?              @relation(fields: [gradeMetricId], references: [id], onDelete: SetNull)
  gradeMetricId        String?
  monthlyTuitionAmount Decimal?
  tuitionMonths        Int[]                     @default([])
  enrollmentCosts      StudyPlanEnrollmentCost[]

  @@unique([schoolId, name])
  @@map("study_plans")
}

model StudyPlanEnrollmentCost {
  id          String    @id @default(cuid())
  studyPlanId String
  studyPlan   StudyPlan @relation(fields: [studyPlanId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  name        String
  amount      Decimal
  order       Int       @default(0)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([studyPlanId])
  @@map("study_plan_enrollment_costs")
}

model Course {
  id                 String                     @id @default(cuid())
  name               String
  code               String
  shortName          String
  organizationId     String
  organization       Organization               @relation(fields: [organizationId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  schoolId           String
  school             School                     @relation(fields: [schoolId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  subjectId          String
  subject            Subject                    @relation(fields: [subjectId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  studyPlanId        String
  studyPlan          StudyPlan                  @relation(fields: [studyPlanId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  createdAt          DateTime                   @default(now())
  updatedAt          DateTime                   @updatedAt
  students           Student[]
  teacher            Teacher?                   @relation(fields: [teacherId], references: [id], onDelete: SetNull, onUpdate: Cascade)
  teacherId          String?
  assignments        Assignment[]
  quizzes            Quiz[]
  gradeBuckets       GradeBucket[]
  grades             Grade[]
  weeklySchedules    ClassGroupWeeklySchedule[]
  fileShares         FileShareCourse[]
  attendanceSessions AttendanceSession[]
  chats              Chat[]

  @@unique([schoolId, name])
  @@unique([schoolId, code])
  @@unique([schoolId, subjectId, studyPlanId])
  @@map("courses")
}

model ClassGroup {
  id                 String                     @id @default(cuid())
  name               String
  organizationId     String
  organization       Organization               @relation(fields: [organizationId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  schoolId           String
  school             School                     @relation(fields: [schoolId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  studyPlan          StudyPlan                  @relation(fields: [studyPlanId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  active             Boolean
  students           Student[]
  teacher            Teacher?                   @relation(fields: [teacherId], references: [id], onDelete: SetNull, onUpdate: Cascade)
  teacherId          String?
  studyPlanId        String
  assignmentDates    AssignmentDate[]
  quizSchedules      QuizSchedule[]
  quizSubmissions    QuizSubmission[]
  weeklySchedules    ClassGroupWeeklySchedule[]
  fileShares         FileShareClassGroup[]
  attendanceSessions AttendanceSession[]
  habitEvaluations   HabitEvaluation[]
  chats              Chat[]
  studentHistory     StudentClassGroupHistory[]
  createdAt          DateTime                   @default(now())
  updatedAt          DateTime                   @updatedAt

  @@map("class_groups")
}

model Student {
  id                    String                   @id @default(cuid())
  firstName             String
  middleName            String
  fatherName            String
  motherName            String
  documentId            String
  /// Per-student enrollment/invite code used by parents to self-link (reusable, regenerable)
  enrollmentCode        String?                  @unique
  enrollmentCodeGeneratedAt DateTime?             @default(now())
  organizationId        String
  organization          Organization             @relation(fields: [organizationId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  school                School                   @relation(fields: [schoolId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  schoolId              String
  classGroup            ClassGroup?              @relation(fields: [classGroupId], references: [id], onDelete: SetNull, onUpdate: Cascade)
  classGroupId          String?
  birthDate             DateTime
  gender                Gender
  address               String
  phone                 String
  enrollmentStatus      EnrollmentStatus         @default(ACTIVE)
  bloodType             String                   @default("")
  allergies             String                   @default("")
  medicalNotes          String                   @default("")
  emergencyContactName  String                   @default("")
  emergencyContactPhone String                   @default("")
  courses               Course[]
  userId                String?                  @unique
  user                  User?                    @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  parents               Parent[]
  createdAt             DateTime                 @default(now())
  updatedAt             DateTime                 @updatedAt
  quizSubmissions       QuizSubmission[]
  studentGrades         StudentGrade[]
  attendanceRecords     AttendanceRecord[]
  assignmentSubmissions AssignmentSubmission[]
  habitEvaluations      StudentHabitEvaluation[]
  charges               Charge[]
  payments              Payment[]
  classGroupHistory     StudentClassGroupHistory[]
  authTokens            AuthToken[]

  @@map("students")
}

model Parent {
  id             String       @id @default(cuid())
  firstName      String
  middleName     String       @default("")
  fatherName     String
  motherName     String       @default("")
  documentId     String
  phone          String
  email          String
  relationship   String
  occupation     String       @default("")
  workPhone      String       @default("")
  address        String       @default("")
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  students       Student[]
  user           User?        @relation(fields: [userId], references: [id], onDelete: SetNull, onUpdate: Cascade)
  userId         String?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  /// A parent (User) may hold one profile per Organization (federated cross-org identity)
  @@unique([userId, organizationId])
  @@map("parents")
}

model Teacher {
  id                 String              @id @default(cuid())
  firstName          String
  middleName         String
  fatherName         String
  motherName         String
  documentId         String
  organizationId     String
  organization       Organization        @relation(fields: [organizationId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  birthDate          DateTime
  address            String              @default("")
  phoneNumber        String              @default("")
  personalEmail      String              @default("")
  about              String              @default("")
  teacherSince       Int?
  memberSince        DateTime?
  subjects           Subject[]
  gender             Gender
  classGroups        ClassGroup[]
  courses            Course[]
  user               User?               @relation(fields: [userId], references: [id], onDelete: SetNull, onUpdate: Cascade)
  userId             String?             @unique
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt
  assignments        Assignment[]
  quizzes            Quiz[]
  attendanceSessions AttendanceSession[]
  habitEvaluations   HabitEvaluation[]

  @@map("teachers")
}

model Assignment {
  id                String                 @id @default(cuid())
  title             String
  details           String
  type              AssignmentType
  school            School                 @relation(fields: [schoolId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  course            Course                 @relation(fields: [courseId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  date              DateTime
  schoolId          String
  courseId          String
  dates             AssignmentDate[]
  requireSubmission Boolean
  teacher           Teacher?               @relation(fields: [teacherId], references: [id], onDelete: SetNull, onUpdate: Cascade)
  teacherId         String?
  submissions       AssignmentSubmission[]
  chats             Chat[]
  createdAt         DateTime               @default(now())
  updatedAt         DateTime               @updatedAt

  @@map("assignments")
}

model AssignmentSubmission {
  id           String     @id @default(cuid())
  assignmentId String
  assignment   Assignment @relation(fields: [assignmentId], references: [id], onDelete: Cascade)
  studentId    String
  student      Student    @relation(fields: [studentId], references: [id], onDelete: Cascade)
  fileId       String
  file         File       @relation(fields: [fileId], references: [id], onDelete: Cascade)
  submittedAt  DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  @@unique([assignmentId, studentId])
  @@index([assignmentId])
  @@index([studentId])
  @@map("assignment_submissions")
}

model AssignmentDate {
  id           String     @id @default(cuid())
  date         DateTime
  assignment   Assignment @relation(fields: [assignmentId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  assignmentId String
  classGroup   ClassGroup @relation(fields: [classGroupId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  classGroupId String

  @@map("assignment_dates")
}

model Quiz {
  id              String           @id @default(cuid())
  title           String
  details         String
  organization    Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  organizationId  String
  course          Course           @relation(fields: [courseId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  courseId        String
  teacher         Teacher?         @relation(fields: [teacherId], references: [id], onDelete: SetNull, onUpdate: Cascade)
  teacherId       String?
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  questions       QuizQuestion[]
  schedules       QuizSchedule[]
  quizSubmissions QuizSubmission[]

  @@map("quizzes")
}

model QuizQuestion {
  id                  String                   @id @default(cuid())
  question            String
  quiz                Quiz                     @relation(fields: [quizId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  quizId              String
  value               Decimal
  type                QuizQuestionType
  options             QuizQuestionOption[]
  submissionQuestions QuizSubmissionQuestion[]
  timeLimit           Int?

  @@map("quiz_questions")
}

model QuizQuestionOption {
  id                  String                   @id @default(cuid())
  option              String
  question            QuizQuestion             @relation(fields: [questionId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  questionId          String
  isCorrect           Boolean
  submissionQuestions QuizSubmissionQuestion[]

  @@map("quiz_question_options")
}

model QuizSchedule {
  id           String     @id @default(cuid())
  quiz         Quiz       @relation(fields: [quizId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  quizId       String
  classGroup   ClassGroup @relation(fields: [classGroupId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  classGroupId String
  startDate    DateTime
  dueDate      DateTime
  published    Boolean
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  @@map("quiz_schedules")
}

model ClassGroupWeeklySchedule {
  id           String     @id @default(cuid())
  classGroup   ClassGroup @relation(fields: [classGroupId], references: [id], onDelete: Cascade)
  classGroupId String
  course       Course     @relation(fields: [courseId], references: [id], onDelete: Cascade)
  courseId     String
  location     String     @default("")
  remote       Boolean    @default(false)
  remoteLink   String     @default("")
  recess       Boolean    @default(false)
  weekday      WeekDay
  startTime    String // Format: "HH:mm" (e.g., "09:00", "14:30")
  endTime      String // Format: "HH:mm" (e.g., "10:30", "16:00")
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  @@unique([classGroupId, courseId, weekday, startTime])
  @@map("class_group_weekly_schedules")
}

model QuizSubmission {
  id                  String                   @id @default(cuid())
  quiz                Quiz                     @relation(fields: [quizId], references: [id])
  quizId              String
  student             Student                  @relation(fields: [studentId], references: [id])
  studentId           String
  classGroup          ClassGroup               @relation(fields: [classGroupId], references: [id])
  classGroupId        String
  submissionQuestions QuizSubmissionQuestion[]
  score               Decimal
  createdAt           DateTime                 @default(now())
  updatedAt           DateTime                 @updatedAt

  @@map("quiz_submissions")
}

model QuizSubmissionQuestion {
  id               String               @id @default(cuid())
  quizSubmission   QuizSubmission       @relation(fields: [quizSubmissionId], references: [id])
  quizSubmissionId String
  quizQuestion     QuizQuestion         @relation(fields: [quizQuestionId], references: [id])
  quizQuestionId   String
  answer           String
  options          QuizQuestionOption[]
  isCorrect        Boolean
  score            Decimal
  comment          String?

  @@map("quiz_submission_questions")
}

model GradeMetric {
  id                String      @id @default(cuid())
  name              String
  minimum           Decimal
  maximum           Decimal
  minimumApproval   Decimal
  minimumExcellence Decimal
  createdAt         DateTime    @default(now())
  updatedAt         DateTime    @updatedAt
  studyPlans        StudyPlan[]

  @@map("grade_metrics")
}

model GradeBucket {
  id        String   @id @default(cuid())
  name      String
  weight    Decimal
  courseId  String
  course    Course   @relation(fields: [courseId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  grades    Grade[]

  @@map("grade_buckets")
}

model Grade {
  id            String         @id @default(cuid())
  title         String
  comments      String?
  courseId      String
  course        Course         @relation(fields: [courseId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  bucketId      String
  bucket        GradeBucket    @relation(fields: [bucketId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  periodId      String
  period        Period         @relation(fields: [periodId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  date          DateTime
  published     Boolean        @default(false)
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  studentGrades StudentGrade[]

  @@map("grades")
}

model StudentGrade {
  id        String                 @id @default(cuid())
  comments  String?
  gradeId   String
  grade     Grade                  @relation(fields: [gradeId], references: [id], onDelete: Cascade)
  studentId String
  student   Student                @relation(fields: [studentId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  score     Decimal?
  createdAt DateTime               @default(now())
  updatedAt DateTime               @updatedAt
  revisions StudentGradeRevision[]

  @@map("student_grades")
}

model StudentGradeRevision {
  id             String       @id @default(cuid())
  reason         String
  studentGradeId String
  studentGrade   StudentGrade @relation(fields: [studentGradeId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  score          Decimal
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@map("student_grade_revisions")
}

// ==========================================
// Join Requests & Notifications
// ==========================================

model JoinRequest {
  id            String            @id @default(cuid())
  user          User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId        String
  school        School            @relation(fields: [schoolId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  schoolId      String
  requestedRole String // 'ORG_ADMIN', 'TEACHER', 'PARENT'
  documentId    String?
  status        JoinRequestStatus @default(PENDING)
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt

  @@unique([userId, schoolId])
  @@map("join_requests")
}

enum OnboardingAuditAction {
  REQUEST_JOIN_SCHOOL
  LINK_CHILD
  VERIFY_STUDENT
  APPROVE_JOIN_REQUEST
  REJECT_JOIN_REQUEST
  RESEND_INVITATION
  INVITATION_CREATED
  INVITATION_EMAIL_FAILED
  ENROLLMENT_CODE_REGENERATED
  MAGIC_LINK_ISSUED
  MAGIC_LINK_CONSUMED
  MAGIC_LINK_REJECTED
  CHILD_CONNECT_ISSUED
  CHILD_CONNECT_CONSUMED
  CHILD_CONNECT_REJECTED
  BULK_IMPORT_COMMITTED
  CLASS_GROUP_CHANGED
}

enum AuthTokenType {
  MAGIC_LINK
  CHILD_CONNECT
}

enum ImportEntityType {
  STUDENT
  TEACHER
}

enum ImportJobStatus {
  DRY_RUN
  COMMITTED
  FAILED
}

model AuthToken {
  id             String       @id @default(cuid())
  type           AuthTokenType
  tokenHash      String       @unique
  userId         String?
  user           User?        @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  studentId      String?
  student        Student?     @relation(fields: [studentId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  organizationId String?
  organization   Organization? @relation(fields: [organizationId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  metadata       Json?
  expiresAt      DateTime
  consumedAt     DateTime?
  consumedByUserId String?
  createdById    String?
  attempts       Int          @default(0)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@index([type, expiresAt])
  @@index([userId])
  @@index([studentId])
  @@map("auth_tokens")
}

model StudentClassGroupHistory {
  id             String       @id @default(cuid())
  studentId      String
  student        Student      @relation(fields: [studentId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  // Nullable so a deleted class group does not destroy the audit trail: the
  // FK is `SetNull`, which would otherwise violate NOT NULL on delete.
  classGroupId   String?
  classGroup     ClassGroup?  @relation(fields: [classGroupId], references: [id], onDelete: SetNull, onUpdate: Cascade)
  schoolId       String
  school         School       @relation(fields: [schoolId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  startedAt      DateTime     @default(now())
  endedAt        DateTime?
  reason         String?
  createdById    String?
  createdAt      DateTime     @default(now())

  @@index([studentId, startedAt])
  @@index([classGroupId])
  @@map("student_class_group_history")
}

model ImportJob {
  id             String           @id @default(cuid())
  organizationId String
  organization   Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  schoolId       String
  school         School           @relation(fields: [schoolId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  entityType     ImportEntityType
  status         ImportJobStatus  @default(DRY_RUN)
  createdById    String?
  totalRows      Int              @default(0)
  createdCount   Int              @default(0)
  updatedCount   Int              @default(0)
  errorCount     Int              @default(0)
  errors         Json?
  completedAt    DateTime?
  createdAt      DateTime         @default(now())

  @@index([organizationId])
  @@map("import_jobs")
}


model OnboardingAuditLog {
  id             String               @id @default(cuid())
  actorId        String? // user who performed the action (admin or the user themselves)
  userId         String? // affected user
  organizationId String?
  action         OnboardingAuditAction
  detail         String?
  ip             String?
  createdAt      DateTime             @default(now())

  @@index([userId])
  @@index([organizationId])
  @@index([action])
  @@map("onboarding_audit_logs")
}

model InvitationStatus {
  userId    String   @id
  status    String // 'PENDING' | 'SENT' | 'FAILED'
  detail    String?
  updatedAt DateTime @updatedAt

  @@map("invitation_status")
}

model Notification {
  id          String   @id @default(cuid())
  recipient   User     @relation(fields: [recipientId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  recipientId String
  type        String // 'JOIN_REQUEST', 'REQUEST_APPROVED', 'REQUEST_REJECTED'
  title       String
  message     String
  read        Boolean  @default(false)
  relatedId   String?
  createdAt   DateTime @default(now())

  @@index([recipientId])
  @@map("notifications")
}

// ==========================================
// Financial
// ==========================================

model Charge {
  id          String       @id @default(cuid())
  schoolId    String
  school      School       @relation(fields: [schoolId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  year        Int
  studentId   String
  student     Student      @relation(fields: [studentId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  studyPlanId String?
  studyPlan   StudyPlan?   @relation(fields: [studyPlanId], references: [id], onDelete: SetNull, onUpdate: Cascade)
  amount      Decimal
  dueDate     DateTime     @db.Date
  description String       @default("")
  chargeType  ChargeType   @default(CUSTOM)
  status      ChargeStatus @default(PENDING)
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  @@index([schoolId])
  @@index([schoolId, year])
  @@index([studentId])
  @@index([studyPlanId])
  @@map("charges")
}

model Payment {
  id        String   @id @default(cuid())
  studentId String
  student   Student  @relation(fields: [studentId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  amount    Decimal
  paidAt    DateTime @db.Date
  reference String?  @default("")
  createdBy String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([studentId])
  @@map("payments")
}

// ==========================================
// Better-Auth Tables
// ==========================================

model Session {
  id                   String   @id
  expiresAt            DateTime
  token                String   @unique
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt
  ipAddress            String?
  userAgent            String?
  userId               String
  user                 User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  activeOrganizationId String?

  @@index([userId])
  @@map("sessions")
}

model Account {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@index([userId])
  @@map("accounts")
}

model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
  @@map("verifications")
}

model Member {
  id             String       @id
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  userId         String
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  role           String       @default("member")
  createdAt      DateTime     @default(now())

  @@unique([organizationId, userId])
  @@index([userId])
  @@map("members")
}

model Invitation {
  id             String       @id
  email          String
  inviterId      String
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  role           String
  status         String       @default("pending")
  expiresAt      DateTime
  createdAt      DateTime     @default(now())

  @@index([organizationId])
  @@index([email])
  @@map("invitations")
}

model Newsletter {
  id             String       @id @default(cuid())
  title          String
  content        String
  published      Boolean      @default(false)
  publishedAt    DateTime?
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  organizationId String
  school         School       @relation(fields: [schoolId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  schoolId       String
  author         User?        @relation(fields: [authorId], references: [id], onDelete: SetNull, onUpdate: Cascade)
  authorId       String?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@map("newsletters")
}

// ==========================================
// Enums
