# Database (Neon PostgreSQL recommended for production)
DATABASE_URL="postgresql://user:password@host:5432/dbname?schema=public&connection_limit=5&sslmode=require"

# Authentication
BETTER_AUTH_SECRET="generate-with-openssl-rand-base64-32"
JWT_SECRET="same-as-better-auth-secret"

# Application
APP_URL="https://skooltrak.com"
PORT=3000

# CORS - comma-separated list of allowed origins (production only)
# dashboard-backend: https://skooltrak.com
# admin-backend: https://admin.skooltrak.com
CORS_ORIGINS="https://skooltrak.com,https://admin.skooltrak.com"
TRUSTED_ORIGINS="https://skooltrak.com,https://admin.skooltrak.com"

# Cloudflare R2 (S3-compatible storage)
CLOUDFLARE_R2_ENDPOINT="https://xxx.r2.cloudflarestorage.com"
CLOUDFLARE_R2_ACCESS_KEY_ID="your-access-key"
CLOUDFLARE_R2_SECRET_ACCESS_KEY="your-secret-key"
CLOUDFLARE_R2_BUCKET="skooltrak-files"

# Resend (Email)
RESEND_API_KEY="re_xxxxxxxxxxxx"
EMAIL_FROM="Skooltrak <noreply@yourdomain.com>"
