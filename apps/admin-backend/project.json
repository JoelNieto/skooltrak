{
  "name": "admin-backend",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "apps/admin-backend/src",
  "projectType": "application",
  "tags": [],
  "targets": {
    "build": {
      "executor": "nx:run-commands",
      "options": {
        "command": "webpack-cli build",
        "args": ["--config-node-env=production"],
        "cwd": "apps/admin-backend"
      },
      "configurations": {
        "development": {
          "args": ["--config-node-env=development"]
        }
      }
    },
    "openapi": {
      "executor": "nx:run-commands",
      "dependsOn": ["build"],
      "outputs": [
        "{workspaceRoot}/libs/api-client-admin/openapi.json",
        "{workspaceRoot}/libs/api-client-admin/src/lib/generated"
      ],
      "options": {
        "commands": [
          "node dist/apps/admin-backend/main.js",
          "orval --config orval.config.ts --project api-client-admin --clean"
        ],
        "parallel": false,
        "env": {
          "OPENAPI_EXPORT": "true",
          "OPENAPI_OUTPUT": "libs/api-client-admin/openapi.json",
          "DATABASE_URL": "postgresql://openapi:openapi@127.0.0.1:5432/openapi",
          "RESEND_API_KEY": "re_openapi_export"
        }
      }
    },
    "prune-lockfile": {
      "dependsOn": ["build"],
      "cache": true,
      "executor": "@nx/js:prune-lockfile",
      "outputs": [
        "{workspaceRoot}/dist/apps/admin-backend/package.json",
        "{workspaceRoot}/dist/apps/admin-backend/bun.lock"
      ],
      "options": {
        "buildTarget": "build"
      }
    },
    "copy-workspace-modules": {
      "dependsOn": ["build"],
      "cache": true,
      "outputs": ["{workspaceRoot}/dist/apps/admin-backend/workspace_modules"],
      "executor": "@nx/js:copy-workspace-modules",
      "options": {
        "buildTarget": "build"
      }
    },
    "prune": {
      "dependsOn": ["prune-lockfile", "copy-workspace-modules"],
      "executor": "nx:noop"
    },
    "serve": {
      "continuous": true,
      "executor": "@nx/js:node",
      "defaultConfiguration": "development",
      "dependsOn": ["build"],
      "options": {
        "buildTarget": "admin-backend:build",
        "runBuildTargetDependencies": false
      },
      "configurations": {
        "development": {
          "buildTarget": "admin-backend:build:development"
        },
        "production": {
          "buildTarget": "admin-backend:build:production"
        }
      }
    },
    "test": {
      "options": {
        "passWithNoTests": true
      }
    }
  }
}
