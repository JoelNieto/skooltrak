{
  "name": "web-dashboard-e2e",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "projectType": "application",
  "sourceRoot": "apps/web-dashboard-e2e/src",
  "implicitDependencies": [
    "web-dashboard"
  ],
  "// targets": "to see all targets run: nx show project web-dashboard-e2e --web",
  "targets": {
    "prepare-db": {
      "executor": "nx:run-commands",
      "options": {
        "command": "bun apps/web-dashboard-e2e/scripts/prepare-db.ts",
        "cwd": "{workspaceRoot}"
      },
      "cache": false
    },
    "e2e": {
      "dependsOn": [
        "prepare-db"
      ]
    }
  }
}
