{
  "name": "dashboard-backend-e2e",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "projectType": "application",
  "implicitDependencies": ["dashboard-backend"],
  "targets": {
    "e2e": {
      "cache": false,
      "outputs": ["{workspaceRoot}/coverage/{e2eProjectRoot}", "{workspaceRoot}/coverage/dashboard-backend-e2e"],
      "dependsOn": ["dashboard-backend:build", "dashboard-backend:serve"],
      "options": {
        "passWithNoTests": true
      }
    }
  }
}
