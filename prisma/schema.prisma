// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Organization {
  id                  String              @id @default(cuid())
  name                String
  slug                String?             @unique
  logo                String?
  metadata            String?
  description         String
  active              Boolean             @default(true)
  onboardingCompleted Boolean             @default(false)
  users               User[]
  roles               Role[]
  schools             School[]
  subjects            Subject[]
  createdAt           DateTime            @default(now())
  updatedAt           DateTime            @updatedAt
  groups              ClassGroup[]
  courses             Course[]
  Teacher             Teacher[]
  Student             Student[]
  Parent              Parent[]
  quizzes             Quiz[]
  messages            Message[]
  files               File[]
  attendanceSessions  AttendanceSession[]
  // Better-auth organization plugin
  members             Member[]
  invitations         Invitation[]
  @@map("organizations")
}

model User {
  id                String             @id @default(cuid())
  email             String             @unique
  name              String?
  firstName         String
  lastName          String
  password          String
  color             String?
  image             String?
  emailVerified     Boolean            @default(false)
  banned            Boolean            @default(false)
  banReason         String?
  banExpires        DateTime?
  role              Role?              @relation(fields: [roleId], references: [id])
  roleId            String?
  organization      Organization?      @relation(fields: [organizationId], references: [id])
  organizationId    String?
  onboardingStep    String?            // 'choose-path', 'school-setup', 'waiting-approval', 'completed'
  lastLogin         DateTime?
  isBlocked         Boolean            @default(false)
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt
  student           Student?
  teacher           Teacher?
  parent            Parent?
  sentMessages      Message[]
  messageRecipients MessageRecipient[]
  filesOwned        File[]
  fileShares        FileShareUser[]
  notifications     Notification[]
  joinRequests      JoinRequest[]
  // Better-auth relations
  sessions          Session[]
  accounts          Account[]
  members           Member[]
  @@map("users")
}

model Message {
  id              String             @id @default(cuid())
  subject         String
  content         String
  organization    Organization       @relation(fields: [organizationId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  organizationId  String
  sender          User?              @relation(fields: [senderId], references: [id], onDelete: SetNull, onUpdate: Cascade)
  senderId        String?
  recipients      MessageRecipient[]
  parentMessageId String?
  parentMessage   Message?           @relation("MessageReplies", fields: [parentMessageId], references: [id], onDelete: Cascade)
  replies         Message[]          @relation("MessageReplies")
  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt
  deletedAt       DateTime?
  @@map("messages")
}

model MessageRecipient {
  id        String    @id @default(cuid())
  messageId String
  userId    String
  message   Message   @relation(fields: [messageId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  readAt    DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  @@unique([messageId, userId])
  @@map("message_recipients")
}

model File {
  id                    String                 @id @default(cuid())
  organizationId        String
  organization          Organization           @relation(fields: [organizationId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  ownerId               String
  owner                 User                   @relation(fields: [ownerId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  name                  String
  mimeType              String
  size                  Int
  storageKey            String
  sharesUsers           FileShareUser[]
  sharesSchools         FileShareSchool[]
  sharesClassGroups     FileShareClassGroup[]
  sharesCourses         FileShareCourse[]
  assignmentSubmissions AssignmentSubmission[]
  createdAt             DateTime               @default(now())
  updatedAt             DateTime               @updatedAt
  deletedAt             DateTime?

  @@index([organizationId])
  @@index([ownerId])
  @@map("files")
}

model FileShareUser {
  id         String         @id @default(cuid())
  fileId     String
  file       File           @relation(fields: [fileId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  userId     String
  user       User           @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  permission FilePermission
  createdAt  DateTime       @default(now())
  updatedAt  DateTime       @updatedAt

  @@unique([fileId, userId])
  @@index([userId])
  @@map("file_share_users")
}

model FileShareSchool {
  id         String         @id @default(cuid())
  fileId     String
  file       File           @relation(fields: [fileId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  schoolId   String
  school     School         @relation(fields: [schoolId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  permission FilePermission
  createdAt  DateTime       @default(now())
  updatedAt  DateTime       @updatedAt

  @@unique([fileId, schoolId])
  @@index([schoolId])

  @@map("file_share_schools")
}

model FileShareClassGroup {
  id           String         @id @default(cuid())
  fileId       String
  file         File           @relation(fields: [fileId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  classGroupId String
  classGroup   ClassGroup     @relation(fields: [classGroupId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  permission   FilePermission
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt

  @@unique([fileId, classGroupId])
  @@index([classGroupId])
  @@map("file_share_class_groups")
}

model FileShareCourse {
  id         String         @id @default(cuid())
  fileId     String
  file       File           @relation(fields: [fileId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  courseId   String
  course     Course         @relation(fields: [courseId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  permission FilePermission
  createdAt  DateTime       @default(now())
  updatedAt  DateTime       @updatedAt

  @@unique([fileId, courseId])
  @@index([courseId])
  @@map("file_share_courses")
}

model Role {
  id             String        @id @default(cuid())
  name           String
  description    String
  users          User[]
  permissions    Permission[]
  organization   Organization? @relation(fields: [organizationId], references: [id])
  organizationId String?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  @@unique([organizationId, name])
  @@map("roles")
}

model Permission {
  id            String   @id @default(cuid())
  descriptiveId String   @unique
  description   String
  roles         Role[]
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  @@map("permissions")
}

model School {
  id             String       @id @default(cuid())
  organization   Organization @relation(fields: [organizationId], references: [id])
  organizationId String
  name           String
  shortName      String
  logo           String
  address        String
  city           String
  state          String
  zip            String
  country        String
  email          String
  phone          String
  website        String
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  studyPlans     StudyPlan[]
  degrees        Degree[]
  courses        Course[]
  classGroups    ClassGroup[]
  students       Student[]
  assignments    Assignment[]
  currentYear    Int          @default(2025)
  periods        Period[]
  fileShares     FileShareSchool[]
  joinRequests   JoinRequest[]

  @@map("schools")
}

model Period {
  id        String   @id @default(cuid())
  schoolId  String
  school    School   @relation(fields: [schoolId], references: [id])
  name      String
  shortName String
  year      Int
  startDate DateTime
  endDate   DateTime
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  courses   Course[]
  grades    Grade[]

  @@map("periods")
}

model Subject {
  id             String       @id @default(cuid())
  organization   Organization @relation(fields: [organizationId], references: [id])
  organizationId String
  name           String
  code           String
  courses        Course[]
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  teachers       Teacher[]

  @@unique([organizationId, name, code])
  @@map("subjects")
}

model Degree {
  id         String      @id @default(cuid())
  name       String
  shortName  String
  schoolId   String
  school     School      @relation(fields: [schoolId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  createdAt  DateTime    @default(now())
  updatedAt  DateTime    @updatedAt
  studyPlans StudyPlan[]

  @@map("degrees")
}

model StudyPlan {
  id            String       @id @default(cuid())
  name          String
  shortName     String
  level         Int
  degreeId      String
  degree        Degree       @relation(fields: [degreeId], references: [id])
  description   String
  code          String
  schoolId      String
  school        School       @relation(fields: [schoolId], references: [id])
  courses       Course[]
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt
  classGroups   ClassGroup[]
  gradeMetric   GradeMetric? @relation(fields: [gradeMetricId], references: [id], onDelete: SetNull)
  gradeMetricId String?

  @@unique([schoolId, name])
  @@unique([schoolId, code])
  @@map("study_plans")
}

model Course {
  id                 String                     @id @default(cuid())
  name               String
  code               String
  shortName          String
  organizationId     String
  organization       Organization               @relation(fields: [organizationId], references: [id])
  schoolId           String
  school             School                     @relation(fields: [schoolId], references: [id])
  subjectId          String
  subject            Subject                    @relation(fields: [subjectId], references: [id])
  studyPlanId        String
  studyPlan          StudyPlan                  @relation(fields: [studyPlanId], references: [id])
  createdAt          DateTime                   @default(now())
  updatedAt          DateTime                   @updatedAt
  students           Student[]
  teacher            Teacher?                   @relation(fields: [teacherId], references: [id], onDelete: SetNull, onUpdate: Cascade)
  teacherId          String?
  assignments        Assignment[]
  quizzes            Quiz[]
  currentPeriod      Period?                    @relation(fields: [currentPeriodId], references: [id], onDelete: SetNull, onUpdate: Cascade)
  currentPeriodId    String?
  gradeBuckets       GradeBucket[]
  grades             Grade[]
  weeklySchedules    ClassGroupWeeklySchedule[]
  fileShares         FileShareCourse[]
  attendanceSessions AttendanceSession[]

  @@unique([schoolId, name])
  @@unique([schoolId, code])
  @@unique([schoolId, subjectId, studyPlanId])
  @@map("courses")
}

model ClassGroup {
  id                 String                     @id @default(cuid())
  name               String
  shortName          String
  organizationId     String
  organization       Organization               @relation(fields: [organizationId], references: [id])
  schoolId           String
  school             School                     @relation(fields: [schoolId], references: [id])
  studyPlan          StudyPlan                  @relation(fields: [studyPlanId], references: [id])
  active             Boolean
  students           Student[]
  teacher            Teacher?                   @relation(fields: [teacherId], references: [id])
  teacherId          String?
  studyPlanId        String
  assignmentDates    AssignmentDate[]
  quizSchedules      QuizSchedule[]
  quizSubmissions    QuizSubmission[]
  weeklySchedules    ClassGroupWeeklySchedule[]
  fileShares         FileShareClassGroup[]
  attendanceSessions AttendanceSession[]
  createdAt          DateTime                   @default(now())
  updatedAt          DateTime                   @updatedAt

  @@map("class_groups")
}

model Student {
  id                    String                 @id @default(cuid())
  firstName             String
  middleName            String
  fatherName            String
  motherName            String
  documentId            String
  organizationId        String
  organization          Organization           @relation(fields: [organizationId], references: [id])
  school                School                 @relation(fields: [schoolId], references: [id])
  schoolId              String
  classGroup            ClassGroup?            @relation(fields: [classGroupId], references: [id])
  classGroupId          String?
  birthDate             DateTime
  gender                Gender
  address               String
  phone                 String
  enrollmentStatus      EnrollmentStatus       @default(ACTIVE)
  bloodType             String                 @default("")
  allergies             String                 @default("")
  medicalNotes          String                 @default("")
  emergencyContactName  String                 @default("")
  emergencyContactPhone String                 @default("")
  courses               Course[]
  userId                String                 @unique
  user                  User                   @relation(fields: [userId], references: [id])
  parents               Parent[]
  createdAt             DateTime               @default(now())
  updatedAt             DateTime               @updatedAt
  quizSubmissions       QuizSubmission[]
  studentGrades         StudentGrade[]
  attendanceRecords     AttendanceRecord[]
  assignmentSubmissions AssignmentSubmission[]

  @@map("students")
}

model Parent {
  id             String       @id @default(cuid())
  firstName      String
  middleName     String       @default("")
  fatherName     String
  motherName     String       @default("")
  documentId     String
  phone          String
  email          String
  relationship   String
  occupation     String       @default("")
  workPhone      String       @default("")
  address        String       @default("")
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])
  students       Student[]
  user           User?        @relation(fields: [userId], references: [id])
  userId         String?      @unique
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@map("parents")
}

model Teacher {
  id                 String              @id @default(cuid())
  firstName          String
  middleName         String
  fatherName         String
  motherName         String
  documentId         String
  organizationId     String
  organization       Organization        @relation(fields: [organizationId], references: [id])
  birthDate          DateTime
  address            String              @default("")
  phoneNumber        String              @default("")
  personalEmail      String              @default("")
  about              String              @default("")
  teacherSince       Int?
  memberSince        DateTime?
  subjects           Subject[]
  gender             Gender
  classGroups        ClassGroup[]
  courses            Course[]
  user               User                @relation(fields: [userId], references: [id])
  userId             String              @unique
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt
  assignments        Assignment[]
  quizzes            Quiz[]
  attendanceSessions AttendanceSession[]

  @@map("teachers")
}

model Assignment {
  id                String                 @id @default(cuid())
  title             String
  details           String
  type              AssignmentType
  school            School                 @relation(fields: [schoolId], references: [id])
  course            Course                 @relation(fields: [courseId], references: [id])
  date              DateTime
  schoolId          String
  courseId          String
  dates             AssignmentDate[]
  requireSubmission Boolean
  teacher           Teacher                @relation(fields: [teacherId], references: [id])
  teacherId         String
  submissions       AssignmentSubmission[]
  createdAt         DateTime               @default(now())
  updatedAt         DateTime               @updatedAt

  @@map("assignments")
}

model AssignmentSubmission {
  id           String     @id @default(cuid())
  assignmentId String
  assignment   Assignment @relation(fields: [assignmentId], references: [id], onDelete: Cascade)
  studentId    String
  student      Student    @relation(fields: [studentId], references: [id], onDelete: Cascade)
  fileId       String
  file         File       @relation(fields: [fileId], references: [id], onDelete: Cascade)
  submittedAt  DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  @@unique([assignmentId, studentId])
  @@index([assignmentId])
  @@index([studentId])
  @@map("assignment_submissions")
}

model AssignmentDate {
  id           String     @id @default(cuid())
  date         DateTime
  assignment   Assignment @relation(fields: [assignmentId], references: [id])
  assignmentId String
  classGroup   ClassGroup @relation(fields: [classGroupId], references: [id])
  classGroupId String

  @@map("assignment_dates")
}

model Quiz {
  id              String           @id @default(cuid())
  title           String
  details         String
  organization    Organization     @relation(fields: [organizationId], references: [id])
  organizationId  String
  course          Course           @relation(fields: [courseId], references: [id])
  courseId        String
  teacher         Teacher          @relation(fields: [teacherId], references: [id])
  teacherId       String
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  questions       QuizQuestion[]
  schedules       QuizSchedule[]
  quizSubmissions QuizSubmission[]

  @@map("quizzes")
}

model QuizQuestion {
  id                  String                   @id @default(cuid())
  question            String
  quiz                Quiz                     @relation(fields: [quizId], references: [id])
  quizId              String
  value               Decimal
  type                QuizQuestionType
  options             QuizQuestionOption[]
  submissionQuestions QuizSubmissionQuestion[]
  timeLimit           Int?

  @@map("quiz_questions")
}

model QuizQuestionOption {
  id                  String                   @id @default(cuid())
  option              String
  question            QuizQuestion             @relation(fields: [questionId], references: [id])
  questionId          String
  isCorrect           Boolean
  submissionQuestions QuizSubmissionQuestion[]

  @@map("quiz_question_options")
}

model QuizSchedule {
  id           String     @id @default(cuid())
  quiz         Quiz       @relation(fields: [quizId], references: [id])
  quizId       String
  classGroup   ClassGroup @relation(fields: [classGroupId], references: [id])
  classGroupId String
  startDate    DateTime
  dueDate      DateTime
  published    Boolean
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  @@map("quiz_schedules")
}

model ClassGroupWeeklySchedule {
  id           String     @id @default(cuid())
  classGroup   ClassGroup @relation(fields: [classGroupId], references: [id], onDelete: Cascade)
  classGroupId String
  course       Course     @relation(fields: [courseId], references: [id], onDelete: Cascade)
  courseId     String
  location     String     @default("")
  remote       Boolean    @default(false)
  remoteLink   String     @default("")
  recess       Boolean    @default(false)
  weekday      WeekDay
  startTime    String // Format: "HH:mm" (e.g., "09:00", "14:30")
  endTime      String // Format: "HH:mm" (e.g., "10:30", "16:00")
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  @@unique([classGroupId, courseId, weekday, startTime])
  @@map("class_group_weekly_schedules")
}

model QuizSubmission {
  id                  String                   @id @default(cuid())
  quiz                Quiz                     @relation(fields: [quizId], references: [id])
  quizId              String
  student             Student                  @relation(fields: [studentId], references: [id])
  studentId           String
  classGroup          ClassGroup               @relation(fields: [classGroupId], references: [id])
  classGroupId        String
  submissionQuestions QuizSubmissionQuestion[]
  score               Decimal
  createdAt           DateTime                 @default(now())
  updatedAt           DateTime                 @updatedAt

  @@map("quiz_submissions")
}

model QuizSubmissionQuestion {
  id               String               @id @default(cuid())
  quizSubmission   QuizSubmission       @relation(fields: [quizSubmissionId], references: [id])
  quizSubmissionId String
  quizQuestion     QuizQuestion         @relation(fields: [quizQuestionId], references: [id])
  quizQuestionId   String
  answer           String
  options          QuizQuestionOption[]
  isCorrect        Boolean
  score            Decimal
  comment          String?

  @@map("quiz_submission_questions")
}

model GradeMetric {
  id                String      @id @default(cuid())
  name              String
  minimum           Decimal
  maximum           Decimal
  minimumApproval   Decimal
  minimumExcellence Decimal
  createdAt         DateTime    @default(now())
  updatedAt         DateTime    @updatedAt
  studyPlans        StudyPlan[]

  @@map("grade_metrics")
}

model GradeBucket {
  id        String   @id @default(cuid())
  name      String
  weight    Decimal
  courseId  String
  course    Course   @relation(fields: [courseId], references: [id])
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  grades    Grade[]

  @@map("grade_buckets")
}

model Grade {
  id            String         @id @default(cuid())
  title         String
  comments      String?
  courseId      String
  course        Course         @relation(fields: [courseId], references: [id])
  bucketId      String
  bucket        GradeBucket    @relation(fields: [bucketId], references: [id])
  periodId      String
  period        Period         @relation(fields: [periodId], references: [id])
  date          DateTime
  published     Boolean        @default(false)
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  studentGrades StudentGrade[]

  @@map("grades")
}

model StudentGrade {
  id        String                @id @default(cuid())
  comments  String?
  gradeId   String
  grade     Grade                 @relation(fields: [gradeId], references: [id], onDelete: Cascade)
  studentId String
  student   Student               @relation(fields: [studentId], references: [id])
  score     Decimal?
  createdAt DateTime              @default(now())
  updatedAt DateTime              @updatedAt
  revisions StudentGradeRevision[]

  @@map("student_grades")
}

model StudentGradeRevision {
  id            String        @id @default(cuid())
  reason        String
  studentGradeId String
  studentGrade  StudentGrade  @relation(fields: [studentGradeId], references: [id])
  score         Decimal
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  @@map("student_grade_revisions")
}

// ==========================================
// Join Requests & Notifications
// ==========================================

model JoinRequest {
  id            String            @id @default(cuid())
  user          User              @relation(fields: [userId], references: [id])
  userId        String
  school        School            @relation(fields: [schoolId], references: [id])
  schoolId      String
  requestedRole String            // 'ORG_ADMIN', 'TEACHER', 'PARENT'
  documentId    String?
  status        JoinRequestStatus @default(PENDING)
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt

  @@unique([userId, schoolId])
  @@map("join_requests")
}

model Notification {
  id          String   @id @default(cuid())
  recipient   User     @relation(fields: [recipientId], references: [id])
  recipientId String
  type        String   // 'JOIN_REQUEST', 'REQUEST_APPROVED', 'REQUEST_REJECTED'
  title       String
  message     String
  read        Boolean  @default(false)
  relatedId   String?
  createdAt   DateTime @default(now())

  @@index([recipientId])
  @@map("notifications")
}

// ==========================================
// Better-Auth Tables
// ==========================================

model Session {
  id                   String    @id
  expiresAt            DateTime
  token                String    @unique
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt
  ipAddress            String?
  userAgent            String?
  userId               String
  user                 User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  activeOrganizationId String?

  @@index([userId])
  @@map("sessions")
}

model Account {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@index([userId])
  @@map("accounts")
}

model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
  @@map("verifications")
}

model Member {
  id             String       @id
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  userId         String
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  role           String       @default("member")
  createdAt      DateTime     @default(now())

  @@unique([organizationId, userId])
  @@index([userId])
  @@map("members")
}

model Invitation {
  id             String       @id
  email          String
  inviterId      String
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  role           String
  status         String       @default("pending")
  expiresAt      DateTime
  createdAt      DateTime     @default(now())

  @@index([organizationId])
  @@index([email])
  @@map("invitations")
}

// ==========================================
// Enums
// ==========================================

enum Gender {
  FEMALE
  MALE
}

enum AssignmentType {
  HOMEWORK
  EXAM
  QUIZ
  PROJECT
  PAPER
  NEW
}

enum QuizQuestionType {
  TEXT
  SINGLE_CHOICE
  MULTIPLE_CHOICE
  TRUE_FALSE
  MATCH
}

enum WeekDay {
  MONDAY
  TUESDAY
  WEDNESDAY
  THURSDAY
  FRIDAY
  SATURDAY
  SUNDAY
}

enum FilePermission {
  VIEW
  EDIT
}

enum AttendanceStatus {
  PRESENT
  ABSENT
  LATE
  SICK_LEAVE
  EXCUSED
}

enum EnrollmentStatus {
  ACTIVE
  CANDIDATE
  RETIRED
}

enum JoinRequestStatus {
  PENDING
  APPROVED
  REJECTED
}

model AttendanceSession {
  id             String             @id @default(cuid())
  date           DateTime           @db.Date
  courseId       String
  course         Course             @relation(fields: [courseId], references: [id], onDelete: Cascade)
  classGroupId   String
  classGroup     ClassGroup         @relation(fields: [classGroupId], references: [id], onDelete: Cascade)
  teacherId      String
  teacher        Teacher            @relation(fields: [teacherId], references: [id])
  organizationId String
  organization   Organization       @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  records        AttendanceRecord[]
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt

  @@unique([courseId, classGroupId, date])
  @@index([courseId])
  @@index([classGroupId])
  @@index([date])
  @@map("attendance_sessions")
}

model AttendanceRecord {
  id                  String            @id @default(cuid())
  attendanceSessionId String
  attendanceSession   AttendanceSession @relation(fields: [attendanceSessionId], references: [id], onDelete: Cascade)
  studentId           String
  student             Student           @relation(fields: [studentId], references: [id], onDelete: Cascade)
  status              AttendanceStatus
  comment             String?
  createdAt           DateTime          @default(now())
  updatedAt           DateTime          @updatedAt

  @@unique([attendanceSessionId, studentId])
  @@index([studentId])
  @@map("attendance_records")
}
